{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mag-server-manager.local/schemas/service-template.schema.json",
  "title": "Mag Server Manager servis şablonu",
  "description": "Eklenti klasöründeki templates/*.json dosyaları. Dosya tek bir şablon nesnesi ya da { categories, templates } biçiminde olabilir. Ayrıntılar: docs/plugin-gelistirme.md",
  "oneOf": [
    { "$ref": "#/$defs/template" },
    { "$ref": "#/$defs/file" }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templates"],
      "properties": {
        "$schema": { "type": "string" },
        "categories": {
          "type": "array",
          "description": "Eklentinin tanımladığı ek gruplar (Servis ekle sayfasındaki bölümler).",
          "items": { "$ref": "#/$defs/category" }
        },
        "templates": {
          "type": "array",
          "items": { "$ref": "#/$defs/template" }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "displayName"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$", "description": "Eklenti önekiyle başlamalı (ör. services.extra.search)." },
        "displayName": { "type": "string", "maxLength": 64 },
        "order": { "type": "integer", "description": "Küçük olan önce gelir; yerleşik gruplar 10 (Veritabanları) ve 20 (Uygulamalar)." }
      }
    },
    "placeholderText": {
      "type": "string",
      "description": "Yer tutucular: {{host}}, {{port}}, {{username}}, {{password}}, {{database}}, {{encryptionKey}}; biçimleyiciler :url ve :ado (ör. {{password:url}})."
    },
    "environmentValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "value": { "type": "string", "maxLength": 4096 },
        "secret": { "type": "boolean", "default": false, "description": "Parola/anahtar içeriyorsa true; loglarda maskelenir." }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "containerPort", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,15}$", "description": "Kısa ad (db, http, api)." },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "role": { "enum": ["primary", "webUi"], "default": "primary", "description": "İlk primary port bağlantı adresinde kullanılır; webUi dışarıya açıksa \"Aç\" bağlantısı gösterilir." },
        "label": { "type": "string", "maxLength": 64 },
        "publishByDefault": { "type": "boolean", "default": true }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": { "enum": ["none", "name", "fixed", "email"], "default": "none" },
        "defaultUsername": { "type": "string" },
        "usernameLabel": { "type": "string" },
        "password": { "enum": ["none", "standard", "mssqlComplex"], "default": "none", "description": "Boş bırakılırsa güçlü parola üretilir." },
        "database": { "type": "boolean", "default": false },
        "defaultDatabase": { "type": "string" },
        "reservedUsernames": { "type": "array", "items": { "type": "string" } },
        "generateEncryptionKey": { "type": "boolean", "default": false, "description": "Kurulumda 64 karakterlik anahtar üretilir; {{encryptionKey}} ile kullanılır." }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "displayName", "category", "description", "image", "tags", "ports", "healthCommand"],
      "properties": {
        "$schema": { "type": "string" },
        "key": { "type": "string", "maxLength": 96, "pattern": "^[a-z0-9.]+\\.[a-z0-9][a-z0-9-]{0,39}$", "description": "<systemname küçük harf>.<ad>; servis kaydında kalıcı saklanır, değiştirmeyin." },
        "displayName": { "type": "string", "maxLength": 64 },
        "category": { "enum": ["database", "application"], "description": "Temel tür." },
        "group": { "type": "string", "description": "Servis ekle sayfasındaki grup; yoksa category grubu. Yerleşik: database, application." },
        "description": { "type": "string", "maxLength": 500 },
        "logo": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]{0,59}\\.(svg|png|webp)$", "description": "Eklentinin Content klasöründeki dosya." },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "image": { "type": "string", "maxLength": 255, "description": "Etiketsiz Docker imajı (ör. getmeili/meilisearch)." },
        "tags": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$" }, "description": "İlki önerilen sürüm." },
        "ports": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/port" } },
        "credentials": { "$ref": "#/$defs/credentials" },
        "dataPath": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$", "description": "Container içindeki kalıcı veri klasörü." },
        "dataOwner": { "type": "string", "pattern": "^\\d{1,10}(:\\d{1,10})?$", "description": "Sunucu klasörü modunda klasör sahipliği (uid:gid)." },
        "environment": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/environmentValue" }, "description": "Kimlik bilgisi değişkenleri; kullanıcı ezemez. {{host}}/{{port}} kullanılamaz." },
        "defaultEnvironment": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/environmentValue" }, "description": "Kullanıcının değiştirebileceği varsayılanlar; yer tutucu içeremez." },
        "command": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 1024 }, "description": "İmajdan sonraki argümanlar; her biri ayrı ayrı kaçışlanır." },
        "healthCommand": { "type": "string", "maxLength": 2000, "description": "Container içinde sh -c ile çalışır (tek satır). Zorunlu." },
        "readinessCommand": { "type": "string", "maxLength": 2000 },
        "consoleCommand": { "type": "string", "maxLength": 2000 },
        "consoleLabel": { "type": "string", "maxLength": 32 },
        "connectionString": { "$ref": "#/$defs/placeholderText" },
        "suggestedEnvironment": { "type": "object", "additionalProperties": { "$ref": "#/$defs/placeholderText" }, "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } },
        "requiresX86": { "type": "boolean", "default": false },
        "minMemoryMb": { "type": "integer", "minimum": 0 },
        "memoryHint": { "type": "string", "maxLength": 300 },
        "warnOnMajorUpgrade": { "type": "boolean", "default": false },
        "healthTimeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 1800, "default": 180 },
        "notes": { "type": "string", "maxLength": 1000 }
      }
    }
  }
}
