@model DokployPageViewModel
@{
    ViewData["Title"] = $"{Model.ServerName} · Dokploy";
    ViewData["Page"] = "dokploy";
    ViewData[PluginContent.PagePluginKey] = DokployPlugin.SystemName;
}

<partial name="_ServerHeader" model="Model.Page" />

<div class="dokploy-toolbar">
    <div class="dokploy-toolbar-title">
        <h2 class="dokploy-heading">Dokploy durumu</h2>
        <span class="text-xs text-slate-400" data-panel-updated></span>
    </div>
    <div class="dokploy-toolbar-actions">
        <button type="button" class="btn-secondary" data-health-check data-url="@Url.Action("HealthCheck", new { id = Model.ServerId })" title="Sunucudaki servisleri ve panelin /api/health yanıtını şimdi kontrol et">
            <span class="spinner" data-spinner hidden></span>
            @Icons.Render("shield", "h-4 w-4") Sağlık kontrolü
        </button>
        <button type="button" class="btn-secondary" data-panel-refresh title="Durumu sunucudan yeniden yükle">
            <span class="spinner" data-spinner hidden></span>
            @Icons.Render("refresh", "h-4 w-4") Yenile
        </button>
    </div>
</div>

<div data-remote-panel data-url="@Url.Action("StatusPanel", new { id = Model.ServerId })">
    <section class="panel">
        <div class="empty-state">
            <span class="spinner h-6 w-6"></span>
            <p>Dokploy durumu sunucudan alınıyor…</p>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
}
