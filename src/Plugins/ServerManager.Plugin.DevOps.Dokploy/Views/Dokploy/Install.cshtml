@model DokployPageViewModel
@{
    var canInstall = User.HasPermission(DokployPermissions.Install);
    var watching = Model.InstallationId is not null;
    ViewData["Title"] = $"{Model.ServerName} · Dokploy kurulumu";
    ViewData["Page"] = "dokploy-install";
    ViewData[PluginContent.PagePluginKey] = DokployPlugin.SystemName;
    ViewData["PageLead"] = watching
        ? "Kurulum çıktısı sunucudan geldiği anda burada gösterilir; sayfayı kapatsanız da kurulum devam eder."
        : "Sihirbaz sunucuyu kontrol eder, onayınızı alır ve Dokploy'u resmi kurulum betiğiyle kurar.";
    var steps = new[]
    {
        ("server", "Sunucu"),
        ("compatibility", "Uyumluluk"),
        ("docker", "Docker"),
        ("ports", "Portlar"),
        ("confirm", "Onay"),
        ("install", "Kurulum"),
        ("health", "Sağlık kontrolü"),
        ("complete", "Tamamlandı")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/lib/xterm/xterm.css" />
}

<partial name="_ServerHeader" model="Model.Page" />

<div class="dokploy-wizard" data-dokploy-wizard
     data-server-id="@Model.ServerId"
     data-server-name="@Model.ServerName"
     data-installation-id="@Model.InstallationId"
     data-can-install="@(canInstall ? "true" : "false")"
     data-hub-url="@Url.Content("~" + DokployHub.Path)"
     data-compatibility-url="@Url.Action("CompatibilityPanel", new { id = Model.ServerId })"
     data-start-url="@Url.Action("StartInstall", new { id = Model.ServerId })"
     data-install-url="@Url.Action("Install", new { id = Model.ServerId })">

    <ol class="wizard-steps" aria-label="Kurulum adımları">
        @for (var i = 0; i < steps.Length; i++)
        {
            var (key, label) = steps[i];
            <li class="wizard-step @(key == "server" ? "is-done" : "")" data-step="@key">
                <span class="wizard-step-marker">@(i + 1)</span>
                <span class="wizard-step-label">@label</span>
            </li>
        }
    </ol>

    <section class="panel dokploy-target">
        <div class="panel-body flex flex-wrap items-center justify-between gap-3">
            <div class="min-w-0">
                <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Hedef sunucu</p>
                <p class="truncate font-semibold text-slate-900 dark:text-slate-100">@Model.ServerName <span class="font-mono text-sm font-normal text-slate-500">@Model.Page.Server.IpAddress</span></p>
            </div>
            <a asp-controller="Servers" asp-action="Index" class="btn-ghost btn-sm" title="Kurulum için başka bir sunucu seçmek üzere sunucu listesine dön">Başka sunucu seç</a>
        </div>
    </section>

    @if (!watching && !canInstall)
    {
        <p class="alert-warning">Dokploy kurmak için yetkiniz yok. Kurulum geçmişini Dokploy sekmesinden görüntüleyebilirsiniz.</p>
    }

    <div data-wizard-panel="check" hidden>
        <div class="dokploy-toolbar">
            <h2 class="dokploy-heading">Ön kontroller</h2>
            <button type="button" class="btn-secondary" data-compatibility-retry title="Kontrolleri sunucuda yeniden çalıştır">
                <span class="spinner" data-spinner hidden></span>
                @Icons.Render("refresh", "h-4 w-4") Tekrar kontrol et
            </button>
        </div>
        <div data-compatibility-panel>
            <section class="panel">
                <div class="empty-state">
                    <span class="spinner h-6 w-6"></span>
                    <p>İşletim sistemi, kaynaklar, Docker, portlar ve internet erişimi kontrol ediliyor…</p>
                </div>
            </section>
        </div>
    </div>

    <section class="panel mt-6" data-wizard-panel="confirm" hidden>
        <div class="panel-header"><h2 class="panel-title">Kurulum onayı</h2></div>
        <form class="panel-body space-y-5" data-install-form novalidate>
            <div class="alert-warning space-y-1 text-sm">
                <p class="font-medium">Kurulum betiği sunucuda root yetkisiyle şunları yapar:</p>
                <ul class="list-disc pl-5">
                    <li>Docker kurulu değilse Docker'ı kurar.</li>
                    <li>Docker Swarm'ı sıfırdan başlatır (<span class="font-mono">docker swarm leave --force</span>).</li>
                    <li>80 ve 443 portlarında Traefik'i, 3000 portunda Dokploy panelini yayınlar.</li>
                </ul>
            </div>
            <fieldset>
                <legend class="form-label">Sürüm</legend>
                <div class="dokploy-version-options">
                    <label class="check-card">
                        <input type="radio" name="VersionChoice" value="" class="form-check" checked />
                        <span>
                            <span class="check-card-title">Son kararlı sürüm</span>
                            <span class="check-card-text">Önerilen. Betik en güncel kararlı sürümü seçer.</span>
                        </span>
                    </label>
                    <label class="check-card">
                        <input type="radio" name="VersionChoice" value="canary" class="form-check" />
                        <span>
                            <span class="check-card-title">Canary</span>
                            <span class="check-card-text">Geliştirme sürümü; üretim için önerilmez.</span>
                        </span>
                    </label>
                    <label class="check-card">
                        <input type="radio" name="VersionChoice" value="custom" class="form-check" />
                        <span>
                            <span class="check-card-title">Belirli sürüm</span>
                            <span class="check-card-text">Örneğin <span class="font-mono">v0.25.3</span>.</span>
                        </span>
                    </label>
                </div>
                <div class="mt-3" data-custom-version hidden>
                    <label for="dokploy-version" class="form-label">Sürüm etiketi</label>
                    <input id="dokploy-version" name="Version" class="form-control form-control-mono dokploy-version-input" placeholder="v0.25.3" autocomplete="off" spellcheck="false" maxlength="64" />
                    <span class="field-validation-valid" data-valmsg-for="Version"></span>
                </div>
            </fieldset>
            <p class="alert-error" data-form-error hidden></p>
            <div class="flex flex-wrap gap-2">
                <button type="submit" class="btn-primary" title="Sunucu adını yazarak onaylayın ve kurulumu başlatın">
                    <span class="spinner" data-spinner hidden></span>
                    @Icons.Render("download", "h-4 w-4") Kurulumu başlat
                </button>
                <a asp-action="Index" asp-route-id="@Model.ServerId" class="btn-secondary" title="Kurulum yapmadan Dokploy sekmesine dön">Vazgeç</a>
            </div>
        </form>
    </section>

    <section class="panel mt-6" data-wizard-panel="install" hidden>
        <div class="panel-header">
            <h2 class="panel-title">Kurulum çıktısı</h2>
            <span class="badge-info" data-install-status><span class="badge-dot"></span><span data-install-status-text>Bağlanıyor…</span></span>
        </div>
        <div class="dokploy-console" data-install-console></div>
        <div class="panel-body space-y-3" data-install-result hidden>
            <p data-install-message></p>
            <div class="flex flex-wrap gap-2">
                <a asp-action="Index" asp-route-id="@Model.ServerId" class="btn-primary" title="Dokploy durumunu ve servislerini görüntüle">@Icons.Render("rocket", "h-4 w-4") Dokploy durumuna git</a>
                @if (canInstall)
                {
                    <a asp-action="Install" asp-route-id="@Model.ServerId" class="btn-secondary" data-install-again hidden title="Ön kontrollerden başlayarak kurulumu yeniden dene">@Icons.Render("refresh", "h-4 w-4") Yeniden dene</a>
                }
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/lib/xterm/xterm.js"></script>
    <script src="~/lib/xterm/addon-fit.js"></script>
}
