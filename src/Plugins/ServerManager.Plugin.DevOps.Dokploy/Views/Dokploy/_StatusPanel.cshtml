@model DokployPanelModel<DokployOverviewDto>
@{
    var overview = Model.Data;
    var instance = overview.Instance;
    var host = overview.Host;
    var canInstall = User.HasPermission(DokployPermissions.Install);
    var canManage = User.HasPermission(DokployPermissions.Manage);
}

<div data-dokploy-status data-has-instance="@(instance is null ? "false" : "true")">
    @if (overview.RunningInstallationId is { } runningId)
    {
        <div class="alert-info mb-6 flex flex-wrap items-center justify-between gap-3">
            <span>Bu sunucuda Dokploy kurulumu sürüyor.</span>
            <a asp-action="Install" asp-route-id="@Model.ServerId" asp-route-installationId="@runningId" class="btn-primary btn-sm" title="Kurulum çıktısını canlı izle">@Icons.Render("terminal", "h-4 w-4") Kurulumu izle</a>
        </div>
    }

    @if (instance is null)
    {
        <section class="panel">
            <div class="empty-state">
                <span class="empty-state-icon">@Icons.Render("rocket", "h-6 w-6")</span>
                @if (overview.HostError is not null)
                {
                    <p class="empty-state-title">Dokploy durumu okunamadı</p>
                    <p class="max-w-xl">@overview.HostError</p>
                }
                else
                {
                    <p class="empty-state-title">Bu sunucuda Dokploy kurulu değil</p>
                    <p class="max-w-xl">Kurulum sihirbazı önce sunucunun uygunluğunu (işletim sistemi, RAM, Docker, portlar, internet) kontrol eder, ardından resmi kurulum betiğini çalıştırır.</p>
                }
                @if (canInstall && overview.RunningInstallationId is null)
                {
                    <a asp-action="Install" asp-route-id="@Model.ServerId" class="btn-primary mt-3" title="Uyumluluk kontrolüyle başlayan kurulum sihirbazını aç">@Icons.Render("download", "h-4 w-4") Dokploy kur</a>
                }
            </div>
        </section>
    }
    else
    {
        <section class="panel">
            <div class="panel-header">
                <h2 class="panel-title">Dokploy</h2>
                <span class="@DokployDisplay.StatusBadgeClass(instance.Status)"><span class="badge-dot"></span>@DokployDisplay.StatusText(instance.Status)</span>
            </div>
            @if (!string.IsNullOrEmpty(instance.StatusMessage))
            {
                <p class="panel-note dokploy-status-message">@instance.StatusMessage</p>
            }
            @if (instance.Status == DokployStatus.NotInstalled && canInstall && overview.RunningInstallationId is null)
            {
                <div class="panel-body flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 dark:border-slate-800">
                    <span class="text-sm text-slate-600 dark:text-slate-300">Dokploy sunucudan kaldırılmış görünüyor.</span>
                    <a asp-action="Install" asp-route-id="@Model.ServerId" class="btn-primary btn-sm" title="Uyumluluk kontrolüyle başlayan kurulum sihirbazını aç">@Icons.Render("download", "h-4 w-4") Yeniden kur</a>
                </div>
            }
            <dl class="dokploy-facts">
                <div class="dokploy-fact">
                    <dt>Sürüm</dt>
                    <dd class="font-mono">@(instance.Version ?? "—")</dd>
                </div>
                <div class="dokploy-fact">
                    <dt>Adres</dt>
                    <dd class="truncate">
                        <a href="@instance.BaseUrl" target="_blank" rel="noopener noreferrer" class="panel-link font-mono" title="Dokploy panelini yeni sekmede aç">@instance.BaseUrl</a>
                    </dd>
                </div>
                <div class="dokploy-fact">
                    <dt>Port</dt>
                    <dd class="font-mono">@(instance.Port?.ToString() ?? "—")</dd>
                </div>
                <div class="dokploy-fact">
                    <dt>Son sağlık kontrolü</dt>
                    <dd title="@DateDisplay.Format(instance.LastHealthCheckAt)">@DateDisplay.Relative(instance.LastHealthCheckAt)</dd>
                </div>
                <div class="dokploy-fact">
                    <dt>Yanıt süresi</dt>
                    <dd class="tabular-nums">@DokployDisplay.ResponseTime(instance.LastResponseTimeMs)</dd>
                </div>
                <div class="dokploy-fact">
                    <dt>Kurulum</dt>
                    <dd>@(instance.InstalledAt is null ? "Panel dışında kurulmuş" : DateDisplay.Format(instance.InstalledAt))</dd>
                </div>
            </dl>
        </section>

        @if (overview.HostError is not null)
        {
            <p class="alert-warning mt-6">Sunucuya bağlanılamadı, container durumu gösterilemiyor: @overview.HostError</p>
        }
        else if (host is { DockerAvailable: false })
        {
            <p class="alert-warning mt-6">@(host.DockerError ?? "Docker'a erişilemedi.")</p>
        }
        else if (host is not null)
        {
            <section class="panel mt-6">
                <div class="panel-header">
                    <h2 class="panel-title">Servisler ve container'lar</h2>
                    <span class="text-xs text-slate-500">@(host.SwarmActive ? "Docker Swarm etkin" : "Docker Swarm etkin değil")</span>
                </div>
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Ad</th>
                                <th>Tür</th>
                                <th>Image</th>
                                <th>Durum</th>
                                <th>Port</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (host.Services.Count == 0 && host.Containers.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-slate-500">Dokploy'a ait servis veya container bulunamadı.</td></tr>
                            }
                            @foreach (var service in host.Services)
                            {
                                <tr>
                                    <td class="font-mono">@service.Name</td>
                                    <td>Swarm servisi</td>
                                    <td class="max-w-xs truncate font-mono text-xs" title="@service.Image">@service.Image</td>
                                    <td>
                                        <span class="@(service.IsRunning ? "badge-success" : "badge-danger")" title="Çalışan / istenen replika">@DokployDisplay.Replicas(service)</span>
                                    </td>
                                    <td class="font-mono text-xs">@(service.Ports ?? "—")</td>
                                </tr>
                            }
                            @foreach (var container in host.Containers)
                            {
                                <tr>
                                    <td class="font-mono">@container.Name</td>
                                    <td>Container</td>
                                    <td class="max-w-xs truncate font-mono text-xs" title="@container.Image">@container.Image</td>
                                    <td>
                                        <span class="@(container.IsRunning ? "badge-success" : "badge-danger")" title="@container.Status">@DokployDisplay.ContainerStateText(container.State)</span>
                                    </td>
                                    <td class="text-xs text-slate-500">@container.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section class="panel mt-6">
            <div class="panel-header">
                <h2 class="panel-title">Projeler</h2>
                @if (instance.HasApiKey)
                {
                    <button type="button" class="btn-ghost btn-sm" data-projects-refresh title="Proje listesini Dokploy API'den yeniden al">@Icons.Render("refresh", "h-4 w-4") Yenile</button>
                }
            </div>
            @if (instance.HasApiKey)
            {
                <div data-projects-panel data-url="@Url.Action("ProjectsPanel", new { id = Model.ServerId })">
                    <div class="empty-state">
                        <span class="spinner h-5 w-5"></span>
                        <p>Projeler Dokploy API'den alınıyor…</p>
                    </div>
                </div>
            }
            else
            {
                <p class="panel-body text-sm text-slate-500">Projeleri görmek için Dokploy'da <span class="font-medium">Settings → Profile → API/CLI</span> bölümünden bir API anahtarı oluşturup aşağıdaki ayarlara kaydedin.</p>
            }
        </section>

        @if (canManage)
        {
            <section class="panel mt-6">
                <div class="panel-header"><h2 class="panel-title">Bağlantı ayarları</h2></div>
                <form class="panel-body dokploy-settings" data-dokploy-settings action="@Url.Action("Settings", new { id = Model.ServerId })" novalidate>
                    <div>
                        <label for="dokploy-base-url" class="form-label">Panel adresi</label>
                        <input id="dokploy-base-url" name="BaseUrl" class="form-control form-control-mono" value="@instance.BaseUrl" placeholder="http://203.0.113.10:3000" autocomplete="off" spellcheck="false" required />
                        <span class="field-validation-valid" data-valmsg-for="BaseUrl"></span>
                        <p class="form-hint">Alan adı ve HTTPS tanımladıysanız o adresi yazın. Panel bu adrese sağlık kontrolü yapar.</p>
                    </div>
                    <div>
                        <label for="dokploy-api-key" class="form-label">API anahtarı</label>
                        <input id="dokploy-api-key" name="ApiKey" type="password" class="form-control form-control-mono" placeholder="@(instance.HasApiKey ? "Kayıtlı — değiştirmek için yenisini girin" : "Dokploy API anahtarı")" autocomplete="new-password" spellcheck="false" />
                        <span class="field-validation-valid" data-valmsg-for="ApiKey"></span>
                        <p class="form-hint">Anahtar şifrelenerek saklanır ve hiçbir yerde gösterilmez. Kaydetmeden önce Dokploy'da doğrulanır.</p>
                    </div>
                    <p class="alert-error" data-form-error hidden></p>
                    <div class="flex flex-wrap gap-2">
                        <button type="submit" class="btn-primary" title="Adresi ve anahtarı doğrulayıp kaydet"><span class="spinner" data-spinner hidden></span>Kaydet</button>
                        @if (instance.HasApiKey)
                        {
                            <button type="button" class="btn-ghost-danger" title="Kayıtlı API anahtarını sil" data-ajax-action
                                    data-url="@Url.Action("RemoveApiKey", new { id = Model.ServerId })"
                                    data-confirm-title="API anahtarını kaldır"
                                    data-confirm-message="Kayıtlı Dokploy API anahtarı silinir; proje listesi ve API'den sürüm okuma devre dışı kalır."
                                    data-confirm-label="Kaldır">
                                <span class="spinner" data-spinner hidden></span>
                                @Icons.Render("trash", "h-4 w-4") Anahtarı kaldır
                            </button>
                        }
                    </div>
                </form>
            </section>
        }
    }

    @if (overview.Installations.Count > 0)
    {
        <section class="panel mt-6">
            <div class="panel-header"><h2 class="panel-title">Kurulum geçmişi</h2></div>
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Başlangıç</th>
                            <th>Kullanıcı</th>
                            <th>Sürüm</th>
                            <th>Durum</th>
                            <th>Süre</th>
                            <th class="text-right">Çıktı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var installation in overview.Installations)
                        {
                            <tr>
                                <td class="whitespace-nowrap">@DateDisplay.Format(installation.StartedAt)</td>
                                <td>@(installation.UserName ?? "—")</td>
                                <td class="font-mono">@(installation.RequestedVersion ?? "son kararlı")</td>
                                <td>
                                    <span class="@DokployDisplay.InstallationStatusBadgeClass(installation.Status)" title="@(installation.FailureReason ?? DokployDisplay.InstallationStatusText(installation.Status))">@DokployDisplay.InstallationStatusText(installation.Status)</span>
                                </td>
                                <td class="whitespace-nowrap">@(installation.CompletedAt is null ? "—" : DateDisplay.Duration(installation.StartedAt, installation.CompletedAt))</td>
                                <td class="text-right">
                                    <a asp-action="Install" asp-route-id="@Model.ServerId" asp-route-installationId="@installation.Id" class="panel-link" title="Kurulum çıktısını terminal görünümünde aç">Görüntüle</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
