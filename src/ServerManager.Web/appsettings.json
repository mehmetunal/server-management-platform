{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "AutoCreate": false
  },
  "Security": {
    "MasterKey": "",
    "KeyVersion": 1
  },
  "Seed": {
    "AdminEmail": "",
    "AdminPassword": "",
    "AdminFullName": "Super Admin"
  },
  "Ssh": {
    "ConnectionTimeoutSeconds": 10,
    "CommandTimeoutSeconds": 10
  },
  "Monitoring": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "MaxConcurrency": 4,
    "OfflineAfterFailures": 2,
    "CpuWarningPercent": 80,
    "CpuCriticalPercent": 95,
    "MemoryWarningPercent": 85,
    "MemoryCriticalPercent": 95,
    "DiskWarningPercent": 80,
    "DiskCriticalPercent": 90,
    "RawRetentionHours": 48,
    "HourlyRetentionDays": 90,
    "HealthCheckRetentionDays": 30,
    "MaintenanceIntervalMinutes": 10
  },
  "Docker": {
    "CommandTimeoutSeconds": 60,
    "PullTimeoutSeconds": 600,
    "DefaultLogTail": 200,
    "MaxLogTail": 5000
  },
  "Terminal": {
    "IdleTimeoutMinutes": 30,
    "MaxSessionsPerUser": 5,
    "ReconnectGraceSeconds": 120,
    "OutputBufferKilobytes": 256,
    "ConfirmationTimeoutSeconds": 120,
    "DangerousCommandMode": "Confirm",
    "DangerousCommands": []
  },
  "Files": {
    "MaxEditKilobytes": 1024,
    "MaxUploadMegabytes": 100,
    "OperationTimeoutSeconds": 60,
    "ProtectedPaths": []
  },
  "Deployment": {
    "GitTimeoutSeconds": 300,
    "BuildTimeoutMinutes": 30,
    "DeployTimeoutMinutes": 10,
    "MaxStoredLogKilobytes": 1024,
    "AcmeEmail": ""
  },
  "Plugins": {
    "Directory": "Plugins",
    "InstallOnStartup": []
  },
  "Alerting": {
    "Enabled": true,
    "EvaluationIntervalSeconds": 60,
    "PublicBaseUrl": "",
    "NotificationTimeoutSeconds": 15,
    "UptimeMinimumIntervalSeconds": 30,
    "UptimeMaxConcurrency": 8,
    "UptimeResultRetentionDays": 30,
    "SslCheckIntervalHours": 6,
    "SslExpiringDays": 30,
    "DeliveryRetentionDays": 90
  },
  "Backup": {
    "Enabled": true,
    "SchedulerIntervalSeconds": 30,
    "MaxConcurrency": 2,
    "TimeZone": "Europe/Istanbul",
    "BackupTimeoutMinutes": 240,
    "RestoreTimeoutMinutes": 240,
    "LocalRootPath": "App_Data/backups",
    "KeyDerivationIterations": 600000,
    "MaxStoredLogKilobytes": 256
  },
  "SecurityScan": {
    "ScanIntervalHours": 24,
    "RetentionDays": 180,
    "KeepLatestPerServer": 20
  },
  "Retention": {
    "DeploymentLogDays": 90,
    "BackupRunLogDays": 90,
    "CommandRunDays": 90,
    "TerminalSessionDays": 90,
    "AlertEventDays": 90
  },
  "Cloud": {
    "SyncIntervalHours": 6,
    "Hetzner": {
      "ApiUrl": "https://api.hetzner.cloud/v1/"
    },
    "DigitalOcean": {
      "ApiUrl": "https://api.digitalocean.com/v2/"
    }
  },
  "Telegram": {
    "ApiUrl": "https://api.telegram.org"
  },
  "Discord": {
    "AllowHttp": false
  },
  "GitHub": {
    "ApiUrl": "https://api.github.com",
    "WebUrl": "https://github.com",
    "PublicBaseUrl": "",
    "HttpTimeoutSeconds": 15,
    "ListCacheSeconds": 60
  },
  "Dokku": {
    "Version": "v0.38.31",
    "CommandTimeoutSeconds": 60,
    "InstallTimeoutMinutes": 20
  },
  "Dokploy": {
    "InstallScriptUrl": "https://dokploy.com/install.sh",
    "Port": 3000,
    "MinMemoryMb": 2048,
    "RecommendedDiskGb": 30,
    "InstallTimeoutMinutes": 30,
    "StartupTimeoutSeconds": 180,
    "HttpTimeoutSeconds": 10,
    "HealthCheckIntervalMinutes": 5,
    "MaxStoredOutputKilobytes": 512,
    "InstallationHistoryCount": 10
  },
  "Auth": {
    "SessionTimeoutMinutes": 60
  },
  "TwoFactor": {
    "Required": false
  },
  "Proxy": {
    "TrustForwardedHeaders": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/server-manager-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
