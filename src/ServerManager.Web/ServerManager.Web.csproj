<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>server-manager-web-7c1f2e4a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerManager.Application\ServerManager.Application.csproj" />
    <ProjectReference Include="..\ServerManager.Infrastructure\ServerManager.Infrastructure.csproj" />
    <ProjectReference Include="..\ServerManager.Web.Framework\ServerManager.Web.Framework.csproj" />
  </ItemGroup>

  <!-- Eklentiler yalnızca derleme sırası için referanslanır; uygulama onları Plugins/ klasöründen çalışma anında yükler. -->
  <ItemGroup>
    <ProjectReference Include="..\Plugins\*\*.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="package.json;package-lock.json;Plugins\**" />
    <None Remove="Plugins\**" />
    <None Include="package.json;package-lock.json" />
  </ItemGroup>

  <!-- Kullanım kılavuzu depodaki docs/ klasöründen derlemeye gömülür; uygulama /Guide sayfasında bu kaynakları okur. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\kullanim-kilavuzu.md" LogicalName="ServerManager.Web.Guide.kullanim-kilavuzu.md" />
    <EmbeddedResource Include="..\..\docs\son-kullanici.md" LogicalName="ServerManager.Web.Guide.son-kullanici.md" />
    <EmbeddedResource Include="..\..\docs\images\**\*.png;..\..\docs\images\**\*.jpg;..\..\docs\images\**\*.svg;..\..\docs\images\**\*.webp;..\..\docs\images\**\*.gif" LogicalName="ServerManager.Web.Guide.images.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="PublishPlugins" AfterTargets="Publish">
    <ItemGroup>
      <PluginFile Include="Plugins\**" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFile)" DestinationFiles="@(PluginFile->'$(PublishDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
