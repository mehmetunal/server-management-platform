@model DashboardSummaryDto
@inject AuditActionCatalog AuditCatalog
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Page"] = "dashboard";
    var canCreate = User.HasPermission(Permissions.ServerCreate);
    var canAudit = User.HasPermission(Permissions.AuditView);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-lead">Tüm sunucuların anlık durumu, kaynak kullanımı ve son işlemler</p>
    </div>
    @if (canCreate)
    {
        <a asp-controller="Servers" asp-action="Create" class="btn-primary" title="Panele yeni Linux sunucusu ekle">@Icons.Render("plus", "h-4 w-4") Sunucu ekle</a>
    }
</div>

<div class="dashboard-stats">
    <div class="stat-card">
        <span class="stat-label">Toplam sunucu</span>
        <span class="stat-value" data-live-dashboard="totalServers">@Model.TotalServers</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Online</span>
        <span class="stat-value text-emerald-600 dark:text-emerald-400" data-live-dashboard="onlineServers">@Model.OnlineServers</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Offline</span>
        <span class="stat-value" data-live-dashboard="offlineServers">@Model.OfflineServers</span>
    </div>
    <div class="stat-card">
        <span class="stat-label">Kritik</span>
        <span class="stat-value text-red-600 dark:text-red-400" data-live-dashboard="criticalServers">@Model.CriticalServers</span>
    </div>
</div>

<div class="dashboard-badges">
    <span class="badge-success"><span class="badge-dot"></span> Healthy · @Model.HealthyServers</span>
    <span class="badge-warning"><span class="badge-dot"></span> Warning · @Model.WarningServers</span>
    <span class="badge-danger"><span class="badge-dot"></span> Critical · @Model.CriticalServers</span>
    <span class="badge-dark"><span class="badge-dot"></span> Offline · @Model.OfflineServers</span>
    <span class="badge-info"><span class="badge-dot"></span> Bakımda · @Model.MaintenanceServers</span>
    <span class="badge-neutral"><span class="badge-dot"></span> Bilinmiyor · @Model.UnknownServers</span>
</div>

@{
    var resources = Model.Resources;
    var hasResources = resources.ReportingServers > 0;
    var reportingText = hasResources ? $"{resources.ReportingServers} sunucunun ortalaması" : "Henüz metrik gelmedi";
}
<div class="dashboard-stats mt-6">
    <div class="stat-card">
        <span class="stat-label flex items-center gap-2">@Icons.Render("chart", "h-4 w-4") CPU kullanımı</span>
        <span class="stat-value" data-live-dashboard="cpuText">@MetricDisplay.Percent(resources.AverageCpuUsagePercent)</span>
        <span class="text-xs text-slate-400 dark:text-slate-500" data-live-dashboard="reportingText">@reportingText</span>
    </div>
    <div class="stat-card">
        <span class="stat-label flex items-center gap-2">@Icons.Render("database", "h-4 w-4") RAM kullanımı</span>
        <span class="stat-value" data-live-dashboard="memoryText">@MetricDisplay.Percent(resources.AverageMemoryUsagePercent)</span>
        <span class="text-xs text-slate-400 dark:text-slate-500" data-live-dashboard="reportingText">@reportingText</span>
    </div>
    <div class="stat-card">
        <span class="stat-label flex items-center gap-2">@Icons.Render("archive", "h-4 w-4") Disk kullanımı</span>
        <span class="stat-value" data-live-dashboard="diskText">@MetricDisplay.Percent(resources.AverageDiskUsagePercent)</span>
        <span class="text-xs text-slate-400 dark:text-slate-500">En dolu bölümlerin ortalaması</span>
    </div>
    <div class="stat-card">
        <span class="stat-label flex items-center gap-2">@Icons.Render("signal", "h-4 w-4") Ağ trafiği</span>
        <span class="stat-value text-xl" data-live-dashboard="rxText">@MetricDisplay.Rate(hasResources ? resources.TotalNetworkRxBytesPerSecond : null)</span>
        <span class="text-xs text-slate-400 dark:text-slate-500">Giden: <span data-live-dashboard="txText">@MetricDisplay.Rate(hasResources ? resources.TotalNetworkTxBytesPerSecond : null)</span></span>
    </div>
</div>

<section class="panel mt-6" data-metric-charts data-series-url="@Url.Action("FleetSeries", "Dashboard", new { range = "24h" })" data-live-range="false">
    <div class="panel-header">
        <h2 class="panel-title">Son 24 saat · ortalama kaynak kullanımı</h2>
        <span class="text-xs text-slate-400">%</span>
    </div>
    <div class="panel-body">
        <div class="dashboard-chart">
            <canvas data-metric-chart="fleet" aria-label="Ortalama kaynak kullanımı grafiği" role="img"></canvas>
            <p class="dashboard-chart-empty" data-chart-empty hidden>Henüz metrik verisi yok.</p>
        </div>
    </div>
</section>

<div class="dashboard-lists">
    <section class="panel">
        <div class="panel-header">
            <h2 class="panel-title">Son eklenen sunucular</h2>
            <a asp-controller="Servers" asp-action="Index" class="panel-link" title="Tüm sunucuları listele">Tümü</a>
        </div>
        @if (Model.RecentServers.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state-icon">@Icons.Render("server", "h-6 w-6")</span>
                <p class="empty-state-title">Henüz sunucu eklenmedi</p>
                <p>İlk sunucunuzu ekleyerek başlayın.</p>
                @if (canCreate)
                {
                    <a asp-controller="Servers" asp-action="Create" class="btn-primary btn-sm mt-3" title="Panele yeni Linux sunucusu ekle">@Icons.Render("plus", "h-4 w-4") Sunucu ekle</a>
                }
            </div>
        }
        else
        {
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var server in Model.RecentServers)
                {
                    <li data-live-server-row="@server.Id">
                        <a asp-controller="Servers" asp-action="Details" asp-route-id="@server.Id" title="Sunucu ayrıntılarını aç" class="flex items-center gap-4 px-5 py-3 transition hover:bg-slate-50 dark:hover:bg-slate-800/50">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400">@Icons.Render("server", "h-5 w-5")</span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-medium text-slate-900 dark:text-slate-100">@server.Name</span>
                                <span class="block truncate font-mono text-xs text-slate-500">@server.IpAddress · @ServerDisplay.EnvironmentText(server.Environment)</span>
                            </span>
                            <span class="@ServerDisplay.StatusBadgeClass(server.Status)" data-live-status><span class="badge-dot"></span><span data-live-status-text>@ServerDisplay.StatusText(server.Status)</span></span>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="panel">
        <div class="panel-header">
            <h2 class="panel-title">Son sistem olayları</h2>
            @if (canAudit)
            {
                <a asp-controller="AuditLogs" asp-action="Index" class="panel-link" title="Tüm audit kayıtlarını aç">Tümü</a>
            }
        </div>
        @if (Model.RecentEvents.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-state-icon">@Icons.Render("clipboard", "h-6 w-6")</span>
                <p>Henüz kayıtlı olay yok.</p>
            </div>
        }
        else
        {
            <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                @foreach (var log in Model.RecentEvents)
                {
                    <li class="flex items-start gap-3 px-5 py-3">
                        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full @(log.IsSuccess ? "bg-emerald-500" : "bg-red-500")"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm text-slate-800 dark:text-slate-200">
                                <span class="font-medium">@AuditCatalog.DisplayName(log.Action)</span>
                                @if (!string.IsNullOrEmpty(log.TargetName))
                                {
                                    <span class="text-slate-500"> · @log.TargetName</span>
                                }
                            </p>
                            <p class="truncate text-xs text-slate-500">@log.UserName · @DateDisplay.Relative(log.CreatedAt)</p>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</div>

<div data-live-fleet data-hub-url="@Url.Content("~" + MonitoringHub.Path)" data-dashboard-url="@Url.Action("Live", "Dashboard")" hidden></div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
}
