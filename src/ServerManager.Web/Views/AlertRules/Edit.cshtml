@model AlertRuleFormDto
@{
    ViewData["Title"] = "Kuralı düzenle";
    ViewData["Page"] = "alert-rule-form";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="Kural listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Alarm kuralları</a>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-lead">Değişiklikler bir sonraki değerlendirmede (en geç bir dakika) uygulanır.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-rule-form novalidate autocomplete="off">
    <partial name="_RuleForm" model="Model" />

    <div class="form-actions">
        <a asp-action="Index" class="btn-secondary" title="Kaydetmeden listeye dön">İptal</a>
        <button type="submit" class="btn-primary" title="Değişiklikleri kaydet"><span class="spinner" data-spinner hidden></span> Kaydet</button>
    </div>
</form>
