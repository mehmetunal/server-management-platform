@model string
@* Sayfa başlığındaki "?" bağlantısı: kılavuzda bu sayfanın bölümünü yeni sekmede açar. Model, GuideAnchors sabitlerinden biridir. *@
<a href="@(Url.Action("Index", "Guide"))#@Model" target="_blank" rel="noopener" class="ml-2 inline-flex h-7 w-7 items-center justify-center rounded-full align-middle text-slate-400 transition hover:bg-slate-100 hover:text-brand-600 focus-visible:outline-2 focus-visible:outline-brand-500 dark:hover:bg-slate-800 dark:hover:text-brand-400 print:hidden" title="Bu sayfa için kullanım kılavuzunu aç" aria-label="Yardım: kullanım kılavuzu" data-help-link="@Model">@Icons.Render("question", "h-5 w-5")</a>
