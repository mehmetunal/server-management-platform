@{
    var canDashboard = User.HasPermission(Permissions.DashboardView);
    var canServers = User.HasPermission(Permissions.ServerView);
    var canUsers = User.HasPermission(Permissions.UserManage);
    var canAudit = User.HasPermission(Permissions.AuditView);
    var canPlugins = User.HasPermission(Permissions.PluginManage);
    var canDeployments = User.HasPermission(Permissions.DeploymentView);
}
<aside class="app-sidebar" data-sidebar>
    <div class="flex h-16 shrink-0 items-center gap-3 border-b border-slate-800 px-5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white">@Icons.Render("server", "h-5 w-5")</span>
        <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-white">Server Manager</p>
            <p class="text-[11px] text-slate-500">Operasyon paneli</p>
        </div>
    </div>

    <nav class="app-sidebar-nav flex-1 space-y-0.5 overflow-y-auto px-3 py-3">
        @if (canDashboard)
        {
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Dashboard")" title="Tüm sunucuların özet durumu">@Icons.Render("home") Dashboard</a>
        }

        <p class="nav-group">Altyapı</p>
        @if (canServers)
        {
            <a asp-controller="Servers" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Servers")" title="Sunucuları listele, ekle ve yönet">@Icons.Render("server") Sunucular</a>
        }
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("squares") Gruplar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("cloud") Sağlayıcılar <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">Konteynerler</p>
        <span class="nav-link is-disabled" title="Sunucu sayfasındaki Docker sekmesinden kullanılabilir">@Icons.Render("cube") Docker <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("photo") İmajlar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("database") Volume'lar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("globe") Ağlar <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">Deployment</p>
        @if (canDeployments)
        {
            <a asp-controller="Projects" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Projects")" title="Git deposundan sunuculara dağıtılan projeler">@Icons.Render("folder") Projeler</a>
            <a asp-controller="Deployments" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Deployments")" title="Tüm projelerin deployment geçmişi ve canlı logları">@Icons.Render("rocket") Deployment'lar</a>
        }

        <p class="nav-group">Operasyon</p>
        <span class="nav-link is-disabled" title="Sunucu sayfasındaki Terminal sekmesinden kullanılabilir">@Icons.Render("terminal") Terminal <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sunucu sayfasındaki Files sekmesinden kullanılabilir">@Icons.Render("folder") Dosyalar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("cog") Servisler <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("list") Process'ler <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("document") Loglar <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">İzleme</p>
        <span class="nav-link is-disabled" title="Sunucu sayfasındaki Metrics sekmesinden kullanılabilir">@Icons.Render("chart") Metrikler <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("signal") Uptime <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("bell") Alarmlar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("lock") SSL <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">Yönetim</p>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("archive") Yedekleme <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("shield") Güvenlik <span class="nav-soon">Yakında</span></span>
        @if (canUsers)
        {
            <a asp-controller="Users" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Users")" title="Panel kullanıcılarını ve rollerini yönet">@Icons.Render("users") Kullanıcılar</a>
        }
        @if (canAudit)
        {
            <a asp-controller="AuditLogs" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "AuditLogs")" title="Panelde yapılan tüm işlemlerin kaydı">@Icons.Render("clipboard") Audit Log</a>
        }
        @if (canPlugins)
        {
            <a asp-controller="Plugins" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Plugins")" title="Dokploy gibi DevOps eklentilerini kur, etkinleştir veya devre dışı bırak">@Icons.Render("puzzle") Eklentiler</a>
        }
        <span class="nav-link is-disabled" title="Sonraki fazlarda eklenecek">@Icons.Render("settings") Ayarlar <span class="nav-soon">Yakında</span></span>
    </nav>
</aside>
