@{
    var canDashboard = User.HasPermission(Permissions.DashboardView);
    var canServers = User.HasPermission(Permissions.ServerView);
    var canUsers = User.HasPermission(Permissions.UserManage);
    var canAudit = User.HasPermission(Permissions.AuditView);
}
<aside class="app-sidebar" data-sidebar>
    <div class="flex h-16 shrink-0 items-center gap-3 border-b border-slate-800 px-5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white">@Icons.Render("server", "h-5 w-5")</span>
        <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-white">Server Manager</p>
            <p class="text-[11px] text-slate-500">Operasyon paneli</p>
        </div>
    </div>

    <nav class="app-sidebar-nav flex-1 space-y-0.5 overflow-y-auto px-3 py-3">
        @if (canDashboard)
        {
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Dashboard")">@Icons.Render("home") Dashboard</a>
        }

        <p class="nav-group">Altyapı</p>
        @if (canServers)
        {
            <a asp-controller="Servers" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Servers")">@Icons.Render("server") Sunucular</a>
        }
        <span class="nav-link is-disabled">@Icons.Render("squares") Gruplar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("cloud") Sağlayıcılar <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">Konteynerler</p>
        <span class="nav-link is-disabled">@Icons.Render("cube") Docker <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("photo") İmajlar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("database") Volume'lar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("globe") Ağlar <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">Deployment</p>
        <span class="nav-link is-disabled">@Icons.Render("folder") Projeler <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("rocket") Deployment'lar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("clock") Geçmiş <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">Operasyon</p>
        <span class="nav-link is-disabled">@Icons.Render("terminal") Terminal <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("folder") Dosyalar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("cog") Servisler <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("list") Process'ler <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("document") Loglar <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">İzleme</p>
        <span class="nav-link is-disabled">@Icons.Render("chart") Metrikler <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("signal") Uptime <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("bell") Alarmlar <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("lock") SSL <span class="nav-soon">Yakında</span></span>

        <p class="nav-group">Yönetim</p>
        <span class="nav-link is-disabled">@Icons.Render("archive") Yedekleme <span class="nav-soon">Yakında</span></span>
        <span class="nav-link is-disabled">@Icons.Render("shield") Güvenlik <span class="nav-soon">Yakında</span></span>
        @if (canUsers)
        {
            <a asp-controller="Users" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Users")">@Icons.Render("users") Kullanıcılar</a>
        }
        @if (canAudit)
        {
            <a asp-controller="AuditLogs" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "AuditLogs")">@Icons.Render("clipboard") Audit Log</a>
        }
        <span class="nav-link is-disabled">@Icons.Render("settings") Ayarlar <span class="nav-soon">Yakında</span></span>
    </nav>
</aside>
