@{
    var canDashboard = User.HasPermission(Permissions.DashboardView);
    var canServers = User.HasPermission(Permissions.ServerView);
    var canUsers = User.HasPermission(Permissions.UserManage);
    var canAudit = User.HasPermission(Permissions.AuditView);
    var canPlugins = User.HasPermission(Permissions.PluginManage);
    var canDeployments = User.HasPermission(Permissions.DeploymentView);
    var canAlerts = User.HasPermission(Permissions.AlertView);
    var canBackups = User.HasPermission(Permissions.BackupView);
    var canSecurity = User.HasPermission(Permissions.SecurityView);
    var canDocker = canServers && User.HasPermission(Permissions.DockerView);
    var canTerminal = canServers && User.HasPermission(Permissions.TerminalView);
    var canFiles = canServers && User.HasPermission(Permissions.FileView);
    var canSystem = canServers && User.HasPermission(Permissions.SystemView);
    var canCommands = User.HasPermission(Permissions.CommandView);
    var canCloud = User.HasPermission(Permissions.CloudView);
    var canSettings = User.HasPermission(Permissions.SettingsView);
}
<aside class="app-sidebar" data-sidebar>
    <div class="flex h-16 shrink-0 items-center gap-3 border-b border-slate-800 px-5">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 text-white">@Icons.Render("server", "h-5 w-5")</span>
        <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-white">Server Manager</p>
            <p class="text-[11px] text-slate-500">Operasyon paneli</p>
        </div>
    </div>

    <nav class="app-sidebar-nav flex-1 space-y-0.5 overflow-y-auto px-3 py-3">
        @if (canDashboard)
        {
            <a asp-controller="Dashboard" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Dashboard")" title="Tüm sunucuların özet durumu">@Icons.Render("home") Dashboard</a>
        }

        <p class="nav-group">Altyapı</p>
        @if (canServers)
        {
            <a asp-controller="Servers" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Servers")" title="Sunucuları listele, ekle ve yönet">@Icons.Render("server") Sunucular</a>
        }
        @if (canServers)
        {
            <a asp-controller="ServerGroups" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "ServerGroups")" title="Sunucuları gruplara ayır ve gruba göre yönet">@Icons.Render("squares") Gruplar</a>
        }
        @if (canCloud)
        {
            <a asp-controller="CloudAccounts" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "CloudAccounts")" title="Hetzner ve DigitalOcean hesapları, bulut sunucuları ve sunucu oluşturma">@Icons.Render("cloud") Sağlayıcılar</a>
        }
        @if (canServers)
        {
            <a asp-controller="Costs" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Costs")" title="Sunucuların aylık maliyeti; grup ve sağlayıcı kırılımı">@Icons.Render("chart") Maliyet</a>
        }

        <partial name="_PluginMenuItems" model="MenuGroups.Infrastructure" />
        <p class="nav-group">Konteynerler</p>
        @if (canDocker)
        {
            <a asp-controller="ServerPicker" asp-action="Docker" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Docker")" title="Sunucu seçip Docker container'larını yönet">@Icons.Render("cube") Docker</a>
        }
        @if (canDocker)
        {
            <a asp-controller="ServerPicker" asp-action="Images" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Images")" title="Sunucu seçip Docker imajlarını yönet">@Icons.Render("photo") İmajlar</a>
        }
        @if (canDocker)
        {
            <a asp-controller="ServerPicker" asp-action="Volumes" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Volumes")" title="Sunucu seçip Docker volume'larını yönet">@Icons.Render("database") Volume'lar</a>
        }
        @if (canDocker)
        {
            <a asp-controller="ServerPicker" asp-action="Networks" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Networks")" title="Sunucu seçip Docker ağlarını yönet">@Icons.Render("globe") Ağlar</a>
        }

        <partial name="_PluginMenuItems" model="MenuGroups.Containers" />
        <p class="nav-group">Deployment</p>
        @if (canDeployments)
        {
            <a asp-controller="Projects" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Projects")" title="Git deposundan sunuculara dağıtılan projeler">@Icons.Render("folder") Projeler</a>
            <a asp-controller="Deployments" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Deployments")" title="Tüm projelerin deployment geçmişi ve canlı logları">@Icons.Render("rocket") Deployment'lar</a>
        }

        <partial name="_PluginMenuItems" model="MenuGroups.Deployment" />
        <p class="nav-group">Operasyon</p>
        @if (canTerminal)
        {
            <a asp-controller="ServerPicker" asp-action="Terminal" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Terminal")" title="Sunucu seçip SSH terminali aç">@Icons.Render("terminal") Terminal</a>
        }
        @if (canFiles)
        {
            <a asp-controller="ServerPicker" asp-action="Files" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Files")" title="Sunucu seçip dosyalara SFTP ile göz at">@Icons.Render("folder") Dosyalar</a>
        }
        @if (canSystem)
        {
            <a asp-controller="ServerPicker" asp-action="Services" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Services")" title="Sunucu seçip sistem servislerini yönet">@Icons.Render("cog") Servisler</a>
        }
        @if (canSystem)
        {
            <a asp-controller="ServerPicker" asp-action="Processes" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Processes")" title="Sunucu seçip çalışan process'leri incele">@Icons.Render("list") Process'ler</a>
        }
        @if (canSystem)
        {
            <a asp-controller="ServerPicker" asp-action="Logs" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Logs")" title="Sunucu seçip journal ve /var/log kayıtlarını oku">@Icons.Render("document") Loglar</a>
        }

        @if (canCommands)
        {
            <a asp-controller="CommandRuns" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "CommandRuns", "ServerTemplates")" title="Bir komutu birden çok sunucuda aynı anda çalıştır; betik şablonları">@Icons.Render("bolt") Toplu komut</a>
        }

        <partial name="_PluginMenuItems" model="MenuGroups.Operations" />
        <p class="nav-group">İzleme</p>
        @if (canServers)
        {
            <a asp-controller="ServerPicker" asp-action="Metrics" class="nav-link @NavigationHelper.ActiveActionClass(ViewContext, "ServerPicker", "Metrics")" title="Sunucu seçip kaynak kullanım grafiklerini gör">@Icons.Render("chart") Metrikler</a>
        }
        @if (canAlerts)
        {
            <a asp-controller="Uptime" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Uptime")" title="Web siteleri ve portların erişilebilirlik kontrolleri">@Icons.Render("signal") Uptime</a>
            <a asp-controller="Alerts" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Alerts", "AlertRules", "NotificationChannels")" title="Açık alarmlar, alarm kuralları ve bildirim kanalları">@Icons.Render("bell") Alarmlar</a>
            <a asp-controller="SslCertificates" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "SslCertificates")" title="SSL sertifikalarının bitiş tarihleri">@Icons.Render("lock") SSL</a>
        }

        <partial name="_PluginMenuItems" model="MenuGroups.Monitoring" />
        <p class="nav-group">Yönetim</p>
        @if (canBackups)
        {
            <a asp-controller="BackupJobs" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "BackupJobs", "BackupRuns", "BackupStorages")" title="Dosya, Docker volume ve veritabanı yedekleri; geri yükleme">@Icons.Render("archive") Yedekleme</a>
        }
        @if (canSecurity)
        {
            <a asp-controller="Security" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Security")" title="Sunucuların SSH, port, güvenlik duvarı ve güncelleme denetimi">@Icons.Render("shield") Güvenlik</a>
        }
        @if (canUsers)
        {
            <a asp-controller="Users" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Users")" title="Panel kullanıcılarını ve rollerini yönet">@Icons.Render("users") Kullanıcılar</a>
        }
        @if (canAudit)
        {
            <a asp-controller="AuditLogs" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "AuditLogs")" title="Panelde yapılan tüm işlemlerin kaydı">@Icons.Render("clipboard") Audit Log</a>
        }
        @if (canPlugins)
        {
            <a asp-controller="Plugins" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Plugins")" title="Dokploy gibi DevOps eklentilerini kur, etkinleştir veya devre dışı bırak">@Icons.Render("puzzle") Eklentiler</a>
        }
        <partial name="_PluginMenuItems" model="MenuGroups.Management" />
        @if (canSettings)
        {
            <a asp-controller="Settings" asp-action="Index" class="nav-link @NavigationHelper.ActiveClass(ViewContext, "Settings")" title="Uygulama sürümü, veritabanı durumu ve çalışan yapılandırma">@Icons.Render("settings") Ayarlar</a>
        }
    </nav>
</aside>
