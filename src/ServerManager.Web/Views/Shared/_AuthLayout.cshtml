@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(string.IsNullOrEmpty(title) ? ProductInfo.Name : $"{title} · {ProductInfo.Name}")</title>
    <link rel="icon" href="~/images/mag-mark.png?v=3" type="image/png" />
    <partial name="_ThemeScript" />
    <partial name="_PageStyles" />
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="auth-shell">
        <div class="w-full max-w-md">
            <div class="mb-8 flex flex-col items-center gap-3 text-center">
                <img src="~/images/mag-mark.png?v=3" alt="Mag Server Manager" class="h-20 w-20" width="80" height="80" />
                <div>
                    <h1 class="text-2xl font-semibold text-white">@ProductInfo.Name</h1>
                    <p class="mt-1 text-sm text-slate-400">Sunucu, Docker ve operasyon yönetim paneli</p>
                </div>
            </div>
            @RenderBody()
        </div>
    </div>
    <partial name="_VendorScripts" />
    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_PageModules" />
</body>
</html>
