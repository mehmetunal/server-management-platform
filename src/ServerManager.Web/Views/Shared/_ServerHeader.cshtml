@model ServerPageViewModel
@inject ServerTabRegistry TabRegistry
@{
    var server = Model.Server;
    var monitoring = Model.Monitoring;
    var latest = monitoring.Latest;
    var thresholds = Model.Thresholds;
    var canEdit = User.HasPermission(Permissions.ServerEdit);
    var canDelete = User.HasPermission(Permissions.ServerDelete);
    var canConnect = User.HasPermission(Permissions.ServerConnect);
    var canViewDocker = User.HasPermission(Permissions.DockerView);
    var canViewTerminal = User.HasPermission(Permissions.TerminalView);
    var canViewFiles = User.HasPermission(Permissions.FileView);
    var canViewDeployments = User.HasPermission(Permissions.DeploymentView);
    var canViewSecurity = User.HasPermission(Permissions.SecurityView);
    var canViewSystem = User.HasPermission(Permissions.SystemView);
    var canViewBackups = User.HasPermission(Permissions.BackupView);
    var canViewAlerts = User.HasPermission(Permissions.AlertView);
    var canViewActivity = User.HasPermission(Permissions.AuditView);
    var systemTabs = new (string Key, string Action, string Title, string Tooltip)[]
    {
        (ServerPageViewModel.ServicesTab, "Services", "Services", "Sistem servisleri (systemd / OpenRC)"),
        (ServerPageViewModel.ProcessesTab, "Processes", "Processes", "Çalışan process'ler"),
        (ServerPageViewModel.LogsTab, "Logs", "Logs", "Journal ve /var/log kayıtları"),
        (ServerPageViewModel.NetworkTab, "Network", "Network", "Ağ arayüzleri, rotalar ve dinlenen portlar"),
        (ServerPageViewModel.StorageTab, "Storage", "Storage", "Dosya sistemleri ve diskler")
    };
    var pluginTabs = TabRegistry.GetTabs().Where(t => User.HasPermission(t.Permission)).ToList();
    var activePluginTab = pluginTabs.FirstOrDefault(t => t.Key == Model.ActiveTab);
    var tabLead = ViewData["PageLead"] as string ?? Model.ActiveTab switch
    {
        ServerPageViewModel.MetricsTab => "CPU, RAM, disk ve ağ kullanımının seçilen zaman aralığındaki grafikleri.",
        ServerPageViewModel.DockerTab => "Sunucudaki Docker container, imaj, volume ve ağlarını görüntüleyip yönetin.",
        ServerPageViewModel.TerminalTab => "Tarayıcıdan sunucuya SSH terminali açın; çalıştırılan komutlar kayıt altına alınır.",
        ServerPageViewModel.FilesTab => "Sunucudaki dosyalara SFTP ile göz atın, yükleyin, indirin ve düzenleyin.",
        ServerPageViewModel.DeploymentsTab => "Bu sunucuya Git deposundan dağıtılan projeler ve deployment geçmişi.",
        ServerPageViewModel.ServicesTab => "Sunucudaki sistem servislerini listeleyin; yetkiniz varsa başlatın, durdurun veya yeniden başlatın.",
        ServerPageViewModel.ProcessesTab => "Çalışan process'leri kaynak kullanımına göre inceleyin; gerekirse sonlandırma sinyali gönderin.",
        ServerPageViewModel.LogsTab => "systemd journal veya /var/log altındaki dosyalardan son satırları okuyun ve filtreleyin.",
        ServerPageViewModel.NetworkTab => "Ağ arayüzleri, IP adresleri, rotalar, DNS sunucuları ve dinlenen portlar.",
        ServerPageViewModel.StorageTab => "Bağlı dosya sistemlerinin doluluk ve inode kullanımı ile blok aygıtları.",
        ServerPageViewModel.BackupsTab => "Bu sunucunun yedekleme işleri ve yedek geçmişi.",
        ServerPageViewModel.AlertsTab => "Bu sunucu için tetiklenen alarmlar; onaylayabilir veya sessize alabilirsiniz.",
        ServerPageViewModel.ActivityTab => "Bu sunucu üzerinde yapılan işlemlerin audit kayıtları.",
        ServerPageViewModel.SecurityTab => "SSH ayarları, açık portlar, güvenlik duvarı, güncellemeler ve kullanıcı hesaplarının salt okunur denetimi. Panel hiçbir düzeltmeyi kendiliğinden uygulamaz.",
        _ when activePluginTab is not null => activePluginTab.Lead,
        _ => "Sunucunun bağlantı bilgileri, donanımı ve son izleme verileri."
    };
}

<div data-region="server-header" data-live-server="@server.Id" data-hub-url="@Url.Content("~" + MonitoringHub.Path)">
    <div class="page-header">
        <div class="min-w-0">
            <a asp-controller="Servers" asp-action="Index" class="back-link" title="Sunucu listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Sunucular</a>
            <div class="flex flex-wrap items-center gap-3">
                <h1 class="page-title truncate">@server.Name</h1>
                <span class="@ServerDisplay.StatusBadgeClass(server.Status)" data-live-status><span class="badge-dot"></span><span data-live-status-text>@ServerDisplay.StatusText(server.Status)</span></span>
                <span class="@ServerDisplay.EnvironmentBadgeClass(server.Environment)">@ServerDisplay.EnvironmentText(server.Environment)</span>
            </div>
            <p class="page-lead font-mono">@server.Username@@@server.IpAddress:@server.SshPort · @(server.OperatingSystem ?? "İşletim sistemi bilinmiyor")</p>
        </div>
        <div class="flex flex-wrap gap-2">
            @if (canConnect)
            {
                <button type="button" class="btn-primary" title="SSH bağlantısını dene ve host key'i doğrula" data-connection-test data-url="@Url.Action("TestConnection", "Servers", new { id = server.Id })">
                    <span class="spinner" data-spinner hidden></span>
                    @Icons.Render("bolt", "h-4 w-4")
                    <span data-label>Bağlantıyı Test Et</span>
                </button>
                @if (monitoring.HasTrustedHostKey)
                {
                    <button type="button" class="btn-secondary" title="Metrikleri beklemeden hemen topla" data-collect-metrics data-url="@Url.Action("CollectMetrics", "Servers", new { id = server.Id })">
                        <span class="spinner" data-spinner hidden></span>
                        @Icons.Render("refresh", "h-4 w-4")
                        <span data-label>Şimdi topla</span>
                    </button>
                }
            }
            @if (canEdit)
            {
                <a asp-controller="Servers" asp-action="Edit" asp-route-id="@server.Id" class="btn-secondary" title="Sunucu bilgilerini düzenle">@Icons.Render("pencil", "h-4 w-4") Düzenle</a>
            }
            @if (canDelete)
            {
                <button type="button" class="btn-ghost-danger" title="Sunucuyu panelden kaldır" data-ajax-action
                        data-url="@Url.Action("Delete", "Servers", new { id = server.Id })"
                        data-confirm-title="Sunucuyu sil"
                        data-confirm-message="@server.Name sunucusu listeden kaldırılır ve panelden yönetilemez. Audit kayıtları korunur."
                        data-confirm-name="@server.Name"
                        data-confirm-label="Sunucuyu sil"
                        data-redirect="@Url.Action("Index", "Servers")">
                    <span class="spinner" data-spinner hidden></span>
                    @Icons.Render("trash", "h-4 w-4") Sil
                </button>
            }
        </div>
    </div>

    <p class="mb-6" data-connection-result hidden></p>

    <section class="panel mb-6">
        <div class="grid grid-cols-2 gap-x-6 gap-y-4 p-5 md:grid-cols-3 xl:grid-cols-6">
            @await Html.PartialAsync("_ResourceBar", new ResourceBarModel("CPU", "cpu", latest?.CpuUsagePercent, thresholds.CpuWarningPercent, thresholds.CpuCriticalPercent))
            @await Html.PartialAsync("_ResourceBar", new ResourceBarModel("RAM", "memory", latest?.MemoryUsagePercent, thresholds.MemoryWarningPercent, thresholds.MemoryCriticalPercent))
            @await Html.PartialAsync("_ResourceBar", new ResourceBarModel("Disk", "disk", latest?.DiskUsagePercent, thresholds.DiskWarningPercent, thresholds.DiskCriticalPercent))
            <div>
                <span class="block text-xs font-medium text-slate-500 dark:text-slate-400">Uptime</span>
                <span class="mt-1 block text-sm font-semibold text-slate-900 dark:text-slate-100" data-live-uptime>@MetricDisplay.Uptime(latest?.UptimeSeconds)</span>
            </div>
            <div>
                <span class="block text-xs font-medium text-slate-500 dark:text-slate-400">Load (1 dk)</span>
                <span class="mt-1 block text-sm font-semibold tabular-nums text-slate-900 dark:text-slate-100" data-live-load>@MetricDisplay.Number(latest?.LoadAverage1)</span>
            </div>
            <div>
                <span class="block text-xs font-medium text-slate-500 dark:text-slate-400">Son veri</span>
                <span class="mt-1 block text-sm font-semibold text-slate-900 dark:text-slate-100" data-live-collected>@(latest is null ? "—" : DateDisplay.Format(latest.CollectedAt, "HH:mm:ss"))</span>
            </div>
        </div>
        @if (!monitoring.HasTrustedHostKey)
        {
            <p class="panel-note">İzleme, ilk başarılı bağlantı testinde host key kaydedildikten sonra başlar.</p>
        }
        else if (!monitoring.MonitoringEnabled)
        {
            <p class="panel-note">Otomatik izleme bu sunucu için kapalı. "Şimdi topla" ile elle metrik alabilirsiniz.</p>
        }
    </section>

    <nav class="tab-list" aria-label="Sunucu sekmeleri">
        <a asp-controller="Servers" asp-action="Details" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.OverviewTab ? "is-active" : "")" title="Sunucu özeti ve son durum">Overview</a>
        <a asp-controller="Servers" asp-action="Metrics" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.MetricsTab ? "is-active" : "")" title="Kaynak kullanım grafikleri">Metrics</a>
        @if (canViewDocker)
        {
            <a asp-controller="Docker" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.DockerTab ? "is-active" : "")" title="Container, imaj, volume ve ağlar">Docker</a>
        }
        @if (canViewTerminal)
        {
            <a asp-controller="Terminal" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.TerminalTab ? "is-active" : "")" title="Tarayıcıdan SSH terminali">Terminal</a>
        }
        @if (canViewFiles)
        {
            <a asp-controller="Files" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.FilesTab ? "is-active" : "")" title="SFTP dosya yöneticisi">Files</a>
        }
        @if (canViewDeployments)
        {
            <a asp-controller="ServerDeployments" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.DeploymentsTab ? "is-active" : "")" title="Bu sunucuya dağıtılan projeler ve deployment geçmişi">Deployments</a>
        }
        @if (canViewSecurity)
        {
            <a asp-controller="ServerSecurity" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.SecurityTab ? "is-active" : "")" title="Güvenlik taraması ve bulgular">Security</a>
        }
        @if (canViewSystem)
        {
            foreach (var tab in systemTabs)
            {
                <a asp-controller="ServerSystem" asp-action="@tab.Action" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == tab.Key ? "is-active" : "")" title="@tab.Tooltip">@tab.Title</a>
            }
        }
        @if (canViewBackups)
        {
            <a asp-controller="ServerBackups" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.BackupsTab ? "is-active" : "")" title="Bu sunucunun yedekleme işleri ve geçmişi">Backups</a>
        }
        @if (canViewAlerts)
        {
            <a asp-controller="ServerAlerts" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.AlertsTab ? "is-active" : "")" title="Bu sunucuya ait alarmlar">Alerts</a>
        }
        @if (canViewActivity)
        {
            <a asp-controller="ServerActivity" asp-action="Index" asp-route-id="@server.Id" class="tab @(Model.ActiveTab == ServerPageViewModel.ActivityTab ? "is-active" : "")" title="Bu sunucudaki işlemlerin audit kayıtları">Activity</a>
        }
        @foreach (var tab in pluginTabs)
        {
            <a href="@Url.Action(tab.Action, tab.Controller, new { id = server.Id })" class="tab @(Model.ActiveTab == tab.Key ? "is-active" : "")" title="@tab.Tooltip">@tab.Title</a>
        }
    </nav>
    <p class="tab-lead">@tabLead</p>
</div>
