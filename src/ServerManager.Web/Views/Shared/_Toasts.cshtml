@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
<div class="toast-stack" data-toast-stack>
    @if (!string.IsNullOrEmpty(success))
    {
        <div class="toast-success" role="status" data-toast>
            @Icons.Render("check-circle", "h-5 w-5 shrink-0")
            <p class="flex-1">@success</p>
            <button type="button" class="text-slate-400 hover:text-slate-600" data-toast-close aria-label="Kapat">@Icons.Render("x", "h-4 w-4")</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="toast-error" role="alert" data-toast>
            @Icons.Render("warning", "h-5 w-5 shrink-0")
            <p class="flex-1">@error</p>
            <button type="button" class="text-slate-400 hover:text-slate-600" data-toast-close aria-label="Kapat">@Icons.Render("x", "h-4 w-4")</button>
        </div>
    }
</div>
