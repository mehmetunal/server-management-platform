@model NotificationChannelFormDto
@{
    var provider = (NotificationProviderDto)ViewData[ServerManager.Web.Controllers.NotificationChannelsController.ProviderKey]!;
    ViewData["Title"] = $"{provider.DisplayName} kanalı ekle";
    ViewData["Page"] = "notification-channel-form";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="Kanal listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Bildirim kanalları</a>
        <h1 class="page-title">@provider.DisplayName kanalı ekle</h1>
        <p class="page-lead">@provider.Description Gizli alanlar şifreli saklanır ve tekrar gösterilmez.</p>
    </div>
</div>

<form asp-action="Create" method="post" data-channel-form novalidate autocomplete="off">
    <partial name="_ChannelForm" model="Model" />

    <div class="form-actions">
        <a asp-action="Index" class="btn-secondary" title="Kaydetmeden listeye dön">İptal</a>
        <button type="submit" class="btn-primary" title="Kanalı kaydet; ardından listeden test mesajı gönderebilirsiniz"><span class="spinner" data-spinner hidden></span> Kaydet</button>
    </div>
</form>
