@model ProjectIndexViewModel
@{
    ViewData["Title"] = "Projeler";
    ViewData["Page"] = "projects-index";
    var canManage = User.HasPermission(Permissions.DeploymentManage);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Projeler<partial name="_HelpLink" model="GuideAnchors.Projects" /></h1>
        <p class="page-lead">Git deposundan sunuculara dağıtılan uygulamalar; projeyi açıp deployment başlatın.</p>
    </div>
    @if (canManage)
    {
        <a asp-action="Create" class="btn-primary" title="Git deposunu bir sunucuya bağlayan yeni proje tanımla">@Icons.Render("plus", "h-4 w-4") Proje ekle</a>
    }
</div>

<section class="panel">
    <form method="get" asp-action="Index" class="panel-toolbar project-filters" data-list-filter>
        <div class="search-field lg:col-span-2">
            <span class="search-field-icon">@Icons.Render("search", "h-4 w-4")</span>
            <input type="search" name="search" value="@Model.Filter.Search" class="form-control" placeholder="Proje adı, depo, dal veya sunucu ara…" data-live-search aria-label="Proje ara" />
        </div>
        <select name="serverId" class="form-control" data-auto-submit aria-label="Sunucu">
            <option value="">Tüm sunucular</option>
            @foreach (var server in Model.Servers)
            {
                <option value="@server.Id" selected="@(server.Id == Model.Filter.ServerId)">@server.Name</option>
            }
        </select>
        <div class="project-filter-actions">
            <button type="submit" class="btn-secondary btn-sm" title="Listeyi arama ve filtrelere göre süz">@Icons.Render("search", "h-4 w-4") Filtrele</button>
            <a asp-action="Index" class="btn-ghost btn-sm" data-list-link title="Tüm filtreleri kaldır">Filtreleri temizle</a>
        </div>
    </form>

    <div data-ajax-list>
        <partial name="_ProjectList" model="Model" />
    </div>
</section>
