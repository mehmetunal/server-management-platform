@model ProjectDetailsViewModel
@{
    var project = Model.Project;
    ViewData["Title"] = project.Name;
    ViewData["Page"] = "project-details";
    var canManage = User.HasPermission(Permissions.DeploymentManage);
    var canExecute = User.HasPermission(Permissions.DeploymentExecute);
    var listUrl = Url.Action("Index", "Deployments", new { projectId = project.Id, pageSize = 10, embedded = "project" });
    var canLogs = User.HasPermission(Permissions.DockerView) && project.BuildType != DeploymentBuildType.Commands;
    var envModel = Model.Environment;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="Proje listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Projeler</a>
        <h1 class="page-title">@project.Name</h1>
        <p class="page-lead">@(project.Description ?? $"{project.ServerName} sunucusuna {DeploymentDisplay.BuildTypeText(project.BuildType)} ile dağıtılan proje.")</p>
    </div>
    <div class="flex flex-wrap gap-2">
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@project.Id" class="btn-secondary" title="Depo, build ve ortam ayarlarını düzenle">@Icons.Render("pencil", "h-4 w-4") Düzenle</a>
            <button type="button" class="btn-danger" title="Projeyi panelden kaldır. İsterseniz sunucudaki uygulamayı ve domain yönlendirmesini de silin"
                    data-ajax-action data-url="@Url.Action("Delete", new { id = project.Id })"
                    data-confirm-title="Proje silinsin mi?"
                    data-confirm-message="Proje panelden kaldırılır. Deployment geçmişi denetim için saklanır. Kutuyu işaretlemezseniz sunucudaki klasör ve çalışan uygulama olduğu gibi kalır."
                    data-confirm-name="@project.Name"
                    data-confirm-check="Sunucudaki klasörü, container'ı, imajı, volume'ları ve domain yönlendirmesini de sil"
                    data-check-field="hardDelete"
                    data-confirm-label="Projeyi sil"
                    data-redirect>
                @Icons.Render("trash", "h-4 w-4") Sil
            </button>
        }
    </div>
</div>

@if (project.RunningDeploymentId is Guid runningId)
{
    <div class="alert-info mb-6 flex flex-wrap items-center justify-between gap-3">
        <span class="flex items-center gap-2"><span class="spinner h-4 w-4"></span> Bu projede bir deployment çalışıyor.</span>
        <a asp-controller="Deployments" asp-action="Details" asp-route-id="@runningId" class="btn-secondary btn-sm" title="Çalışan deployment'ın canlı logunu aç">@Icons.Render("eye", "h-4 w-4") Canlı log</a>
    </div>
}

@if (project.EnvironmentUnreadable)
{
    <div class="alert-warning mb-6">Kayıtlı ortam değişkenleri çözülemedi (şifreleme anahtarı değişmiş olabilir). Ortam değişkenleri sekmesinden yeniden girin.</div>
}

<nav class="tab-list mb-6" aria-label="Proje sekmeleri" data-tabs>
    <button type="button" class="tab is-active" data-tab="overview" title="Kaynak, build, domainler ve deployment geçmişi">Genel</button>
    <button type="button" class="tab" data-tab="environment" title="Ortam değişkenlerini yönet (.env)">Ortam değişkenleri</button>
    @if (canLogs)
    {
        <button type="button" class="tab" data-tab="logs" title="Projenin container loglarını izle (docker logs)">Çalışma logları</button>
    }
    <button type="button" class="tab" data-tab="webhook" title="Push ile otomatik deploy (webhook)">Otomatik deploy</button>
</nav>

<div data-tab-panel="overview">
<div class="project-details-grid">
    <div class="project-details-main">
        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">Kaynak</h2></div>
            <dl class="panel-body detail-list">
                <div><dt class="detail-term">Sağlayıcı</dt><dd class="detail-value">@DeploymentDisplay.GitProviderText(project.GitProvider)</dd></div>
                @if (project.GitIntegration is not null)
                {
                    <div><dt class="detail-term">Bağlantı</dt><dd class="detail-value">@(project.GitIntegrationName ?? $"{project.GitIntegration} (eklenti etkin değil)")</dd></div>
                    <div><dt class="detail-term">Depo</dt><dd class="detail-value font-mono break-all">@project.GitRepository</dd></div>
                }
                else
                {
                    <div><dt class="detail-term">Depo</dt><dd class="detail-value font-mono break-all">@project.RepositoryUrl</dd></div>
                }
                <div><dt class="detail-term">Dal</dt><dd class="detail-value"><span class="tag">@project.Branch</span></dd></div>
                @if (project.GitIntegration is not null)
                {
                    <div><dt class="detail-term">Kimlik</dt><dd class="detail-value">Her işlemde bağlantıdan kısa ömürlü anahtar alınır</dd></div>
                }
                else
                {
                    <div><dt class="detail-term">Kimlik</dt><dd class="detail-value">@(project.HasAccessToken ? $"Erişim anahtarı kayıtlı{(project.GitUsername is null ? "" : $" ({project.GitUsername})")}" : "Anahtar yok (herkese açık veya SSH)")</dd></div>
                }
            </dl>
        </section>

        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">Build ve deploy</h2></div>
            <dl class="panel-body detail-list">
                <div><dt class="detail-term">Sunucu</dt><dd class="detail-value"><a asp-controller="ServerDeployments" asp-action="Index" asp-route-id="@project.ServerId" class="panel-link" title="Sunucunun deployment sekmesini aç">@project.ServerName</a></dd></div>
                <div><dt class="detail-term">Klasör</dt><dd class="detail-value font-mono break-all">@project.DeployPath</dd></div>
                <div><dt class="detail-term">Tür</dt><dd class="detail-value">@DeploymentDisplay.BuildTypeText(project.BuildType)</dd></div>
                @switch (project.BuildType)
                {
                    case DeploymentBuildType.DockerCompose:
                        <div><dt class="detail-term">Compose dosyası</dt><dd class="detail-value font-mono">@project.ComposeFile</dd></div>
                        <div><dt class="detail-term">Compose projesi</dt><dd class="detail-value font-mono">@project.ComposeProjectName</dd></div>
                        break;
                    case DeploymentBuildType.Dockerfile:
                        <div><dt class="detail-term">Dockerfile</dt><dd class="detail-value font-mono">@project.DockerfilePath</dd></div>
                        <div><dt class="detail-term">Container</dt><dd class="detail-value font-mono">@project.ContainerName</dd></div>
                        <div><dt class="detail-term">Portlar</dt><dd class="detail-value font-mono">@(project.PortMappings ?? "—")</dd></div>
                        break;
                    default:
                        <div><dt class="detail-term">Sudo</dt><dd class="detail-value">@(project.UseSudoForCommands ? "Evet" : "Hayır")</dd></div>
                        break;
                }
            </dl>
            @if (project.BuildType == DeploymentBuildType.Commands)
            {
                <div class="project-commands">
                    @if (!string.IsNullOrWhiteSpace(project.BuildCommand))
                    {
                        <p class="form-label">Build komutu</p>
                        <pre class="project-command">@project.BuildCommand</pre>
                    }
                    <p class="form-label">Deploy komutu</p>
                    <pre class="project-command">@project.DeployCommand</pre>
                </div>
            }
        </section>

        <section class="panel" data-domains
                 data-build-type="@((int)project.BuildType)"
                 data-compose="@((int)DeploymentBuildType.DockerCompose)"
                 data-commands="@((int)DeploymentBuildType.Commands)"
                 data-custom="@((int)DeploymentTlsMode.Custom)"
                 data-delete-url="@Url.Action("DeleteDomain", new { id = project.Id })">
            <div class="panel-header">
                <h2 class="panel-title">Domainler</h2>
                @if (canManage && project.BuildType != DeploymentBuildType.Commands)
                {
                    <div class="flex flex-wrap gap-2">
                        <button type="button" class="btn-secondary btn-sm" data-proxy-install data-url="@Url.Action("InstallProxy", new { id = project.Id })" title="Sunucuya Traefik vekilini kur veya durmuşsa başlat">@Icons.Render("shield", "h-4 w-4") Vekil kur</button>
                        <button type="button" class="btn-secondary btn-sm" data-routing-apply data-url="@Url.Action("ApplyRouting", new { id = project.Id })" title="Kayıtlı domainleri yeniden build etmeden uygula">@Icons.Render("refresh", "h-4 w-4") Yönlendir</button>
                        <button type="button" class="btn-primary btn-sm" data-domain-add title="Yeni host adı ekle">@Icons.Render("plus", "h-4 w-4") Domain ekle</button>
                    </div>
                }
            </div>
            <div class="panel-body space-y-4">
                @if (project.BuildType == DeploymentBuildType.Commands)
                {
                    <p class="text-sm text-slate-500 dark:text-slate-400">Komutla dağıtılan projeye domain bağlanmaz. Docker Compose veya Dockerfile seçin.</p>
                }
                else
                {
                    <p class="text-sm" data-proxy-status data-url="@Url.Action("ProxyStatus", new { id = project.Id })">Vekil durumu kontrol ediliyor.</p>
                    <div data-domain-list data-url="@Url.Action("Domains", new { id = project.Id })">
                        <partial name="_DomainTable" model="new DomainPanelViewModel { ProjectId = project.Id, BuildType = project.BuildType, Domains = Model.Domains, CanManage = canManage }" />
                    </div>
                    @if (canManage)
                    {
                        <form class="space-y-4" data-domain-form hidden action="@Url.Action("SaveDomain", new { id = project.Id })" novalidate>
                            <input type="hidden" name="Id" value="" />
                            <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                                <div>
                                    <label class="form-label" for="domain-host">Host *</label>
                                    <input id="domain-host" name="Host" class="form-control font-mono" placeholder="api.ornek.com" maxlength="253" spellcheck="false" autocomplete="off" />
                                    <span class="field-validation-error" data-valmsg-for="Host"></span>
                                </div>
                                <div>
                                    <label class="form-label" for="domain-path">Yol</label>
                                    <input id="domain-path" name="Path" class="form-control font-mono" placeholder="/api" maxlength="200" spellcheck="false" autocomplete="off" />
                                    <p class="form-hint">Boşsa host'un tamamı yönlenir.</p>
                                    <span class="field-validation-error" data-valmsg-for="Path"></span>
                                </div>
                                <div>
                                    <label class="form-label" for="domain-port">Container portu *</label>
                                    <input id="domain-port" name="ContainerPort" class="form-control font-mono" inputmode="numeric" value="80" />
                                    <p class="form-hint">Uygulamanın container içinde dinlediği port.</p>
                                    <span class="field-validation-error" data-valmsg-for="ContainerPort"></span>
                                </div>
                                <div data-compose-field>
                                    <label class="form-label" for="domain-service">Compose servisi *</label>
                                    <input id="domain-service" name="ServiceName" class="form-control font-mono" placeholder="web" maxlength="63" spellcheck="false" autocomplete="off" />
                                    <span class="field-validation-error" data-valmsg-for="ServiceName"></span>
                                </div>
                                <div>
                                    <label class="form-label" for="domain-tls">Sertifika *</label>
                                    <select id="domain-tls" name="TlsMode" class="form-control" data-tls-mode asp-items="DeploymentDisplay.TlsModeOptions(DeploymentTlsMode.Cloudflare)"></select>
                                    <p class="form-hint" data-tls-hint="cloudflare">Kilit Cloudflare'de kalır. Sunucu yalnızca 80 dinler.</p>
                                    <p class="form-hint" data-tls-hint="letsencrypt" hidden>Let's Encrypt sertifikayı alır. A kaydı bu sunucuya doğrudan bakmalıdır.</p>
                                    <p class="form-hint" data-tls-hint="custom" hidden>Elinizdeki sertifika ve özel anahtar Traefik'e yazılır.</p>
                                    <span class="field-validation-error" data-valmsg-for="TlsMode"></span>
                                </div>
                            </div>
                            <div data-custom-fields hidden>
                                <div class="space-y-4">
                                    <div>
                                        <label class="form-label" for="domain-cert">Sertifika (PEM)</label>
                                        <textarea id="domain-cert" name="CertificatePem" class="form-control font-mono domain-pem" rows="6" spellcheck="false" placeholder="-----BEGIN CERTIFICATE-----"></textarea>
                                        <p class="form-hint" data-cert-keep hidden>Boş bırakırsanız kayıtlı sertifika korunur.</p>
                                        <span class="field-validation-error" data-valmsg-for="CertificatePem"></span>
                                    </div>
                                    <div>
                                        <label class="form-label" for="domain-key">Özel anahtar (PEM)</label>
                                        <textarea id="domain-key" name="PrivateKey" class="form-control font-mono domain-pem" rows="6" spellcheck="false" placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
                                        <span class="field-validation-error" data-valmsg-for="PrivateKey"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                <button type="submit" class="btn-primary" title="Domaini kaydet ve yönlendirmeyi uygula"><span class="spinner" data-spinner hidden></span> Kaydet</button>
                                <button type="button" class="btn-secondary" data-domain-cancel title="Formu kapat">Vazgeç</button>
                            </div>
                        </form>
                    }
                }
            </div>
        </section>
    </div>

    <div class="project-details-side">
        @if (canExecute)
        {
            <section class="panel">
                <div class="panel-header"><h2 class="panel-title">Deployment başlat</h2></div>
                <form class="panel-body space-y-4" method="post" action="@Url.Action("Deploy", new { id = project.Id })" data-deploy-form data-project-name="@project.Name" data-branch="@project.Branch" novalidate>
                    <div>
                        <label for="deploy-commit" class="form-label">Commit (isteğe bağlı)</label>
                        <input id="deploy-commit" name="CommitSha" class="form-control font-mono" placeholder="Boşsa @project.Branch dalının son hali" maxlength="40" spellcheck="false" autocomplete="off" />
                        <p class="form-hint">Belirli bir commit için tam SHA girin; commit seçili dalda bulunmalı.</p>
                        <span class="field-validation-error" data-valmsg-for="CommitSha"></span>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="submit" class="btn-primary" title="Kodu çek, build et ve sunucuda çalıştır"><span class="spinner" data-spinner hidden></span> @Icons.Render("rocket", "h-4 w-4") Deploy et</button>
                        <button type="button" class="btn-secondary" data-branches-check data-url="@Url.Action("Branches", new { id = project.Id })" title="Depoya bağlanıp dalları listele; erişim bilgilerini doğrular">@Icons.Render("link", "h-4 w-4") Depoyu kontrol et</button>
                    </div>
                    <div class="project-branches" data-branches-result hidden></div>
                </form>
            </section>
        }

        <section class="panel">
            <div class="panel-header">
                <h2 class="panel-title">Ortam değişkenleri</h2>
                <button type="button" class="btn-ghost btn-sm" data-open-tab="environment" title="Ortam değişkenleri sekmesini aç">@Icons.Render("key", "h-4 w-4") Yönet</button>
            </div>
            <div class="panel-body">
                @if (project.EnvironmentKeys.Count > 0)
                {
                    <div class="flex flex-wrap gap-1">
                        @foreach (var key in project.EnvironmentKeys)
                        {
                            <span class="tag">@key</span>
                        }
                    </div>
                    <p class="form-hint mt-3">Değerler şifreli saklanır; yetkiniz varsa sekmeden tek tek görebilirsiniz.</p>
                }
                else
                {
                    <p class="text-sm text-slate-500 dark:text-slate-400">Tanımlı değişken yok.</p>
                }
            </div>
        </section>

        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">Kayıt</h2></div>
            <dl class="panel-body detail-list">
                <div><dt class="detail-term">Oluşturma</dt><dd class="detail-value">@DateDisplay.Format(project.CreatedAt) · @(project.CreatedBy ?? "—")</dd></div>
                <div><dt class="detail-term">Güncelleme</dt><dd class="detail-value">@DateDisplay.Format(project.UpdatedAt) @(project.UpdatedBy is null ? "" : $"· {project.UpdatedBy}")</dd></div>
            </dl>
        </section>
    </div>
</div>

<section class="panel mt-6">
    <div class="panel-header">
        <h2 class="panel-title">Deployment geçmişi</h2>
        <button type="button" class="btn-ghost btn-sm" data-deployments-refresh title="Deployment listesini yeniden yükle">@Icons.Render("refresh", "h-4 w-4") Yenile</button>
    </div>
    <div data-ajax-list data-url="@listUrl">
        <partial name="~/Views/Deployments/_DeploymentList.cshtml" model="Model.Deployments" />
    </div>
</section>
</div>

<div data-tab-panel="environment" hidden>
    <partial name="_LinkedServices" model="Model" />
    <section class="panel" data-env
             data-panel-url="@Url.Action("Panel", "ProjectEnvironment", new { id = project.Id })"
             data-reveal-url="@Url.Action("Reveal", "ProjectEnvironment", new { id = project.Id })"
             data-delete-url="@Url.Action("Delete", "ProjectEnvironment", new { id = project.Id })">
        <div class="panel-header">
            <h2 class="panel-title">Ortam değişkenleri</h2>
            <div class="flex flex-wrap gap-2">
                @if (envModel.CanManage)
                {
                    <button type="button" class="btn-primary btn-sm" data-env-add title="Yeni ortam değişkeni ekle">@Icons.Render("plus", "h-4 w-4") Değişken ekle</button>
                    <button type="button" class="btn-secondary btn-sm" data-env-import-open title=".env içeriği yapıştırın veya dosya yükleyin">@Icons.Render("upload", "h-4 w-4") İçe aktar</button>
                }
                @if (envModel.CanReveal)
                {
                    <a href="@Url.Action("Export", "ProjectEnvironment", new { id = project.Id })" class="btn-secondary btn-sm" data-env-export title="Tüm değişkenleri .env dosyası olarak indir (denetim kaydına yazılır)">@Icons.Render("download", "h-4 w-4") .env indir</a>
                }
                @if (envModel.CanApply && project.BuildType != DeploymentBuildType.Commands)
                {
                    <button type="button" class="btn-secondary btn-sm"
                            data-ajax-action data-url="@Url.Action("Restart", "ProjectRuntime", new { id = project.Id })"
                            data-confirm-title="Değişiklikler uygulansın mı?"
                            data-confirm-message="Kaynak kod çekilmeden ve build yapılmadan .env yeniden yazılır ve container'lar mevcut imajla yeniden oluşturulur. Kısa bir kesinti olabilir."
                            data-confirm-label="Uygula ve yeniden başlat"
                            data-confirm-tone="neutral"
                            data-redirect
                            title="Ortam değişkenlerini sunucuya yaz ve container'ları build etmeden yeniden oluştur">
                        @Icons.Render("refresh", "h-4 w-4") Uygula / Yeniden başlat
                    </button>
                }
            </div>
        </div>
        <div class="panel-body space-y-4 border-b border-slate-200 dark:border-slate-800">
            <p class="form-hint">
                Değişiklikler kaydedilir ancak çalışan uygulamaya hemen yansımaz: bir sonraki deploy'da veya "Uygula / Yeniden başlat" ile proje klasörüne
                <span class="font-mono">.env</span> olarak yazılır (yalnızca SSH kullanıcısı okuyabilir).
                @if (project.BuildType == DeploymentBuildType.DockerCompose)
                {
                    <text>Compose projesinde <span class="font-mono">.env</span> tüm servislere <span class="font-mono">env_file</span> olarak aktarılır; servisin kendi <span class="font-mono">environment:</span> değerleri önceliklidir.</text>
                }
                else if (project.BuildType == DeploymentBuildType.Dockerfile)
                {
                    <text>Container <span class="font-mono">--env-file</span> ile başlatılır.</text>
                }
            </p>

            @if (envModel.CanManage)
            {
                <form class="space-y-4" data-env-form hidden action="@Url.Action("Save", "ProjectEnvironment", new { id = project.Id })" novalidate autocomplete="off">
                    <input type="hidden" name="IsNew" value="true" />
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                        <div>
                            <label class="form-label" for="env-key">Anahtar *</label>
                            <input id="env-key" name="Key" class="form-control font-mono" placeholder="DATABASE_URL" maxlength="200" spellcheck="false" autocomplete="off" />
                            <span class="field-validation-error" data-valmsg-for="Key"></span>
                        </div>
                        <div class="md:col-span-2">
                            <label class="form-label" for="env-value">Değer</label>
                            <input id="env-value" name="Value" class="form-control font-mono" maxlength="32768" spellcheck="false" autocomplete="off" />
                            <p class="form-hint" data-env-value-hint hidden>Kayıtlı değer gösterilmez; yeni değeri girin.</p>
                            <span class="field-validation-error" data-valmsg-for="Value"></span>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <button type="submit" class="btn-primary" title="Değişkeni kaydet"><span class="spinner" data-spinner hidden></span> Kaydet</button>
                        <button type="button" class="btn-secondary" data-env-cancel title="Formu kapat">Vazgeç</button>
                    </div>
                </form>

                <form class="space-y-4" data-env-import hidden action="@Url.Action("Import", "ProjectEnvironment", new { id = project.Id })" novalidate autocomplete="off">
                    <div>
                        <label class="form-label" for="env-import-content">.env içeriği</label>
                        <textarea id="env-import-content" name="Content" class="form-control env-import" rows="8" spellcheck="false" placeholder="DATABASE_URL=postgres://...&#10;API_KEY=..."></textarea>
                        <span class="field-validation-error" data-valmsg-for="Content"></span>
                    </div>
                    <div class="flex flex-wrap items-center gap-4">
                        <label class="check-inline"><input type="file" accept=".env,text/plain" data-env-import-file class="text-sm" /> </label>
                        <label class="check-inline"><input type="radio" name="Mode" value="@((int)EnvironmentImportMode.AddMissing)" class="form-check" checked /> Yalnızca yenileri ekle</label>
                        <label class="check-inline"><input type="radio" name="Mode" value="@((int)EnvironmentImportMode.Overwrite)" class="form-check" /> Var olanların değerini değiştir</label>
                        <label class="check-inline"><input type="radio" name="Mode" value="@((int)EnvironmentImportMode.Replace)" class="form-check" /> Tümünü değiştir</label>
                    </div>
                    <p class="form-hint">Biçim: her satırda <span class="font-mono">ANAHTAR=değer</span>; boş satırlar ve <span class="font-mono">#</span> yorumları kabul edilir. "Tümünü değiştir" listede olmayan değişkenleri siler.</p>
                    <div class="flex flex-wrap gap-2">
                        <button type="submit" class="btn-primary" title="İçe aktar"><span class="spinner" data-spinner hidden></span> İçe aktar</button>
                        <button type="button" class="btn-secondary" data-env-import-cancel title="Formu kapat">Vazgeç</button>
                    </div>
                </form>
            }
        </div>
        <div data-env-table>
            <partial name="_EnvironmentTable" model="envModel" />
        </div>
    </section>
</div>

@if (canLogs)
{
    <div data-tab-panel="logs" hidden>
        <section class="panel" data-project-logs
                 data-containers-url="@Url.Action("Containers", "ProjectRuntime", new { id = project.Id })"
                 data-logs-url="@Url.Action("Logs", "ProjectRuntime", new { id = project.Id })"
                 data-url="" data-container="@project.Slug">
            <div class="log-toolbar">
                <label class="log-tail">
                    <span class="text-slate-500">Container</span>
                    <select class="form-control log-container-select" data-logs-container aria-label="Container"><option value="">Yükleniyor…</option></select>
                </label>
                <label class="log-tail">
                    <span class="text-slate-500">Son</span>
                    <select class="form-control log-tail-select" data-logs-tail aria-label="Satır sayısı">
                        <option value="100">100</option>
                        <option value="200" selected>200</option>
                        <option value="500">500</option>
                        <option value="1000">1000</option>
                        <option value="5000">5000</option>
                    </select>
                    <span class="text-slate-500">satır</span>
                </label>
                <div class="search-field">
                    <span class="search-field-icon">@Icons.Render("search", "h-4 w-4")</span>
                    <input type="search" class="form-control log-search" placeholder="Loglarda ara…" data-logs-search aria-label="Loglarda ara" />
                </div>
                <label class="check-inline" title="error, fatal, panic, exception veya warn geçen satırlar"><input type="checkbox" class="form-check" data-logs-problems /> Yalnızca hata/uyarı</label>
                <label class="check-inline"><input type="checkbox" class="form-check" data-logs-errors /> Yalnızca stderr</label>
                <label class="check-inline"><input type="checkbox" class="form-check" data-logs-wrap checked /> Satır kaydır</label>
                <label class="check-inline"><input type="checkbox" class="form-check" data-logs-follow /> Canlı takip</label>
                <div class="log-toolbar-end">
                    <span class="text-xs text-slate-400" data-logs-status></span>
                    <button type="button" class="btn-secondary btn-sm" data-logs-reload title="Logları yeniden çek">@Icons.Render("refresh", "h-4 w-4") Yenile</button>
                    <button type="button" class="btn-secondary btn-sm" data-logs-download title="Görüntülenen logları dosya olarak indir">@Icons.Render("download", "h-4 w-4") İndir</button>
                </div>
            </div>
            <div class="log-output" data-logs-output>
                <p class="log-empty">Container seçin.</p>
            </div>
        </section>
    </div>
}

<div data-tab-panel="webhook" hidden>
    <section class="panel" data-webhook
             data-panel-url="@Url.Action("Panel", "ProjectWebhook", new { id = project.Id })"
             data-toggle-url="@Url.Action("Toggle", "ProjectWebhook", new { id = project.Id })"
             data-regenerate-url="@Url.Action("Regenerate", "ProjectWebhook", new { id = project.Id })">
        <div class="panel-header"><h2 class="panel-title">Push ile otomatik deploy</h2></div>
        <div data-webhook-body>
            <partial name="_WebhookPanel" model="Model.Webhook" />
        </div>
    </section>
</div>
