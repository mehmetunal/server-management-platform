@{
    ViewData["Title"] = "Erişim reddedildi";
    if (User.Identity?.IsAuthenticated != true)
    {
        Layout = "_AuthLayout";
    }
}
<div class="panel mx-auto max-w-lg">
    <div class="empty-state">
        <span class="empty-state-icon bg-red-100 text-red-500 dark:bg-red-950 dark:text-red-400">@Icons.Render("lock", "h-6 w-6")</span>
        <h1 class="text-lg font-semibold">Bu sayfaya erişim yetkiniz yok</h1>
        <p>Bu işlem için gerekli izne sahip değilsiniz. Erişime ihtiyacınız varsa yöneticinizle iletişime geçin.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn-secondary mt-4">Dashboard'a dön</a>
    </div>
</div>
