@model AuditLogIndexViewModel
@{
    ViewData["Title"] = "Audit Log";
    ViewData["Page"] = "audit-logs";
    var filter = Model.Filter;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Audit Log</h1>
        <p class="page-lead">Panelde kimin, ne zaman, hangi kritik işlemi yaptığının kaydı</p>
    </div>
</div>

<section class="panel">
    <form method="get" asp-action="Index" class="panel-toolbar audit-filters" data-list-filter>
        <div class="search-field lg:col-span-2">
            <span class="search-field-icon">@Icons.Render("search", "h-4 w-4")</span>
            <input type="search" name="search" value="@filter.Search" class="form-control" placeholder="Kullanıcı, hedef, IP ara…" data-live-search />
        </div>
        <select name="@AuditLogIndexViewModel.ActionQueryKey" class="form-control" data-auto-submit asp-items="AuditDisplay.ActionOptions(filter.Action)">
            <option value="">Tüm işlemler</option>
        </select>
        <select name="isSuccess" class="form-control" data-auto-submit>
            <option value="">Tüm sonuçlar</option>
            <option value="true" selected="@(filter.IsSuccess == true)">Başarılı</option>
            <option value="false" selected="@(filter.IsSuccess == false)">Başarısız</option>
        </select>
        <input type="date" name="from" value="@filter.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Başlangıç tarihi" data-auto-submit />
        <input type="date" name="to" value="@filter.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Bitiş tarihi" data-auto-submit />
        <div class="audit-filter-actions">
            <button type="submit" class="btn-secondary btn-sm" title="Kayıtları seçili ölçütlere göre süz">@Icons.Render("search", "h-4 w-4") Filtrele</button>
            <a asp-action="Index" class="btn-ghost btn-sm" data-list-link title="Tüm filtreleri kaldır">Temizle</a>
        </div>
    </form>

    <div data-ajax-list>
        <partial name="_AuditLogList" model="Model" />
    </div>
</section>
