@model AuditLogIndexViewModel
@{
    ViewData["Title"] = "Audit Log";
    var filter = Model.Filter;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Audit Log</h1>
        <p class="page-lead">Panelde yapılan tüm kritik işlemler</p>
    </div>
</div>

<section class="panel">
    <form method="get" asp-action="Index" class="grid grid-cols-1 gap-3 border-b border-slate-200 p-4 sm:grid-cols-2 lg:grid-cols-6 dark:border-slate-800">
        <div class="relative lg:col-span-2">
            <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">@Icons.Render("search", "h-4 w-4")</span>
            <input type="search" name="search" value="@filter.Search" class="form-control pl-9" placeholder="Kullanıcı, hedef, IP ara…" />
        </div>
        <select name="@AuditLogIndexViewModel.ActionQueryKey" class="form-control" data-auto-submit asp-items="AuditDisplay.ActionOptions(filter.Action)">
            <option value="">Tüm işlemler</option>
        </select>
        <select name="isSuccess" class="form-control" data-auto-submit>
            <option value="">Tüm sonuçlar</option>
            <option value="true" selected="@(filter.IsSuccess == true)">Başarılı</option>
            <option value="false" selected="@(filter.IsSuccess == false)">Başarısız</option>
        </select>
        <input type="date" name="from" value="@filter.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Başlangıç tarihi" />
        <input type="date" name="to" value="@filter.To?.ToString("yyyy-MM-dd")" class="form-control" aria-label="Bitiş tarihi" />
        <div class="flex gap-2 sm:col-span-2 lg:col-span-6">
            <button type="submit" class="btn-secondary btn-sm">@Icons.Render("search", "h-4 w-4") Filtrele</button>
            <a asp-action="Index" class="btn-ghost btn-sm">Temizle</a>
        </div>
    </form>

    @if (Model.Logs.Items.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state-icon">@Icons.Render("clipboard", "h-6 w-6")</span>
            <p>Kriterlere uyan kayıt bulunamadı.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Zaman</th>
                        <th>Kullanıcı</th>
                        <th>İşlem</th>
                        <th>Hedef</th>
                        <th>Sonuç</th>
                        <th>IP</th>
                        <th>Detay</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs.Items)
                    {
                        <tr>
                            <td class="whitespace-nowrap text-xs">@DateDisplay.Format(log.CreatedAt, "dd.MM.yyyy HH:mm:ss")</td>
                            <td class="text-sm">@(log.UserName ?? "—")</td>
                            <td><span class="font-medium">@AuditDisplay.ActionText(log.Action)</span><p class="font-mono text-xs text-slate-400">@log.Action</p></td>
                            <td class="text-sm">
                                @if (log.EntityType == AuditEntityTypes.Server && Guid.TryParse(log.EntityId, out var serverId))
                                {
                                    <a asp-controller="Servers" asp-action="Details" asp-route-id="@serverId" class="text-brand-600 hover:underline dark:text-brand-400">@log.TargetName</a>
                                }
                                else
                                {
                                    @(log.TargetName ?? "—")
                                }
                            </td>
                            <td><span class="@(log.IsSuccess ? "badge-success" : "badge-danger")">@(log.IsSuccess ? "Başarılı" : "Başarısız")</span></td>
                            <td class="font-mono text-xs">@(log.IpAddress ?? "—")</td>
                            <td class="max-w-xs truncate text-xs text-slate-500" title="@log.Details">@(log.Details ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.ToPager()" />
    }
</section>
