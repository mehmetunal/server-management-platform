@model AuditLogIndexViewModel
@inject AuditActionCatalog AuditCatalog

@if (Model.Logs.Items.Count == 0)
{
    <div class="empty-state">
        <span class="empty-state-icon">@Icons.Render("clipboard", "h-6 w-6")</span>
        <p>Kriterlere uyan kayıt bulunamadı.</p>
    </div>
}
else
{
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Zaman</th>
                    <th>Kullanıcı</th>
                    <th>İşlem</th>
                    <th>Hedef</th>
                    <th>Sonuç</th>
                    <th>IP</th>
                    <th>Detay</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs.Items)
                {
                    <tr>
                        <td class="audit-time">@DateDisplay.Format(log.CreatedAt, "dd.MM.yyyy HH:mm:ss")</td>
                        <td class="text-sm">@(log.UserName ?? "—")</td>
                        <td><span class="font-medium">@AuditCatalog.DisplayName(log.Action)</span><p class="audit-action-code">@log.Action</p></td>
                        <td class="text-sm">
                            @if (log.EntityType == AuditEntityTypes.Server && Guid.TryParse(log.EntityId, out var serverId))
                            {
                                <a asp-controller="Servers" asp-action="Details" asp-route-id="@serverId" class="audit-target-link" title="Sunucu sayfasını aç">@log.TargetName</a>
                            }
                            else
                            {
                                @(log.TargetName ?? "—")
                            }
                        </td>
                        <td><span class="@(log.IsSuccess ? "badge-success" : "badge-danger")">@(log.IsSuccess ? "Başarılı" : "Başarısız")</span></td>
                        <td class="font-mono text-xs">@(log.IpAddress ?? "—")</td>
                        <td class="audit-details" title="@log.Details">@(log.Details ?? "")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.ToPager()" />
}
