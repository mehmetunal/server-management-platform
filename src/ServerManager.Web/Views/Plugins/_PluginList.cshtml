@model IReadOnlyList<PluginDto>

@if (Model.Count == 0)
{
    <section class="panel">
        <div class="empty-state">
            <span class="empty-state-icon">@Icons.Render("puzzle", "h-6 w-6")</span>
            <p class="empty-state-title">Eklenti yok</p>
            <p>Plugins klasöründe eklenti bulunamadı. Eklentiyi derleyip uygulamayı yeniden başlatın.</p>
        </div>
    </section>
}
else
{
    var enabledCount = Model.Count(p => p.IsLoaded && p.IsInstalled && p.IsEnabled);
    var disabledCount = Model.Count(p => p.IsLoaded && p.IsInstalled && !p.IsEnabled);
    var pendingCount = Model.Count(p => p.IsLoaded && !p.IsInstalled);
    var failedCount = Model.Count(p => !p.IsLoaded);

    <div class="plugin-stats">
        <div class="stat-card">
            <span class="stat-label">Toplam</span>
            <span class="stat-value">@Model.Count</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Etkin</span>
            <span class="stat-value text-emerald-600 dark:text-emerald-400">@enabledCount</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Devre dışı</span>
            <span class="stat-value">@disabledCount</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Kurulmamış</span>
            <span class="stat-value">@(pendingCount + failedCount)</span>
        </div>
    </div>

    @foreach (var group in Model.GroupBy(p => p.Group))
    {
        <section class="panel mb-6">
            <div class="panel-header">
                <h2 class="panel-title">@group.Key</h2>
                <span class="badge-neutral">@group.Count()</span>
            </div>
            <div class="plugin-grid">
                @foreach (var plugin in group)
                {
                    var state = !plugin.IsLoaded ? "is-failed"
                        : !plugin.IsInstalled ? "is-pending"
                        : plugin.IsEnabled ? "is-enabled"
                        : "is-disabled";
                    <article class="plugin-card @state">
                        <div class="plugin-card-top">
                            @if (!string.IsNullOrEmpty(plugin.LogoFile))
                            {
                                <img src="/@PluginContent.BasePath(plugin.SystemName)/@plugin.LogoFile" alt="" class="plugin-logo" width="48" height="48" />
                            }
                            else
                            {
                                <span class="plugin-mark" aria-hidden="true">@plugin.FriendlyName[0]</span>
                            }
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-3">
                                    <p class="plugin-name">@plugin.FriendlyName</p>
                                    @if (!plugin.IsLoaded)
                                    {
                                        <span class="badge-danger shrink-0">Yüklenemedi</span>
                                    }
                                    else if (!plugin.IsInstalled)
                                    {
                                        <span class="badge-neutral shrink-0">Kurulu değil</span>
                                    }
                                    else if (plugin.IsEnabled)
                                    {
                                        <span class="badge-success shrink-0">Etkin</span>
                                    }
                                    else
                                    {
                                        <span class="badge-warning shrink-0">Devre dışı</span>
                                    }
                                </div>
                                <p class="plugin-system-name">@plugin.SystemName@(plugin.Author is null ? "" : $" · {plugin.Author}")</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(plugin.Description))
                        {
                            <p class="plugin-description">@plugin.Description</p>
                        }
                        @if (plugin.LoadError is not null)
                        {
                            <p class="plugin-error">@plugin.LoadError</p>
                        }

                        <div class="plugin-card-foot">
                            <p class="plugin-meta">
                                <span>@plugin.Version</span>
                                @if (plugin.InstalledVersion is not null && plugin.InstalledVersion != plugin.Version)
                                {
                                    <span title="Veritabanında kayıtlı sürüm">Kayıtlı @plugin.InstalledVersion</span>
                                }
                                @if (plugin.IsInstalled)
                                {
                                    <span title="@DateDisplay.Format(plugin.InstalledAt)">@DateDisplay.Relative(plugin.InstalledAt) · @(plugin.InstalledBy ?? "—")</span>
                                }
                            </p>
                            <div class="plugin-actions">
                                @if (plugin.IsLoaded && !plugin.IsInstalled)
                                {
                                    <button type="button" class="btn-primary btn-sm" title="Tablolarını oluştur, izinlerini rollere ekle ve etkinleştir" data-ajax-action
                                            data-url="@Url.Action("Install")"
                                            data-field-system-name="@plugin.SystemName"
                                            data-confirm-title="Eklentiyi kur"
                                            data-confirm-message="@plugin.FriendlyName eklentisinin veritabanı tabloları oluşturulur ve varsayılan izinleri rollere eklenir."
                                            data-confirm-label="Kur"
                                            data-confirm-tone="neutral">
                                        <span class="spinner" data-spinner hidden></span>
                                        @Icons.Render("download", "h-4 w-4") Kur
                                    </button>
                                }
                                else if (plugin.IsInstalled && plugin.IsEnabled)
                                {
                                    <button type="button" class="btn-ghost-danger btn-sm" title="Eklentinin sayfalarını, sekmelerini ve arka plan işlerini durdur" data-ajax-action
                                            data-url="@Url.Action("SetEnabled")"
                                            data-field-system-name="@plugin.SystemName"
                                            data-field-enabled="false"
                                            data-confirm-title="Eklentiyi devre dışı bırak"
                                            data-confirm-message="@plugin.FriendlyName sayfaları ve sunucu sekmesi kapanır, arka plan işleri durur. Tabloları ve verisi silinmez."
                                            data-confirm-label="Devre dışı bırak">
                                        <span class="spinner" data-spinner hidden></span>
                                        @Icons.Render("power", "h-4 w-4") Devre dışı bırak
                                    </button>
                                }
                                else if (plugin.IsInstalled && plugin.IsLoaded)
                                {
                                    <button type="button" class="btn-secondary btn-sm" title="Eklentinin sayfalarını ve sekmelerini yeniden aç" data-ajax-action
                                            data-url="@Url.Action("SetEnabled")"
                                            data-field-system-name="@plugin.SystemName"
                                            data-field-enabled="true"
                                            data-confirm-title="Eklentiyi etkinleştir"
                                            data-confirm-message="@plugin.FriendlyName sayfaları ve sunucu sekmesi yeniden kullanılabilir olur."
                                            data-confirm-label="Etkinleştir"
                                            data-confirm-tone="neutral">
                                        <span class="spinner" data-spinner hidden></span>
                                        @Icons.Render("play", "h-4 w-4") Etkinleştir
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
}
