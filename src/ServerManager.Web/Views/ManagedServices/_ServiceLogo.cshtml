@model ServerManager.Application.ManagedServices.ServiceTemplate?
@* Yerleşik logolar wwwroot/images/services, eklenti logoları eklentinin Content klasöründen (/plugins/{systemname}/) sunulur. *@
<span class="service-logo" aria-hidden="true">
    @if (Model?.LogoPath is { } logoPath)
    {
        <img src="@Url.Content($"~/{logoPath}")" alt="" />
    }
</span>
