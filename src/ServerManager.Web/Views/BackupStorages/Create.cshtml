@model BackupStorageFormDto
@{
    var provider = (BackupStorageProviderDto)ViewData[ServerManager.Web.Controllers.BackupStoragesController.ProviderKey]!;
    ViewData["Title"] = $"{provider.DisplayName} hedefi ekle";
    ViewData["Page"] = "backup-storage-form";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="Depolama listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Yedek depolama</a>
        <h1 class="page-title">@provider.DisplayName hedefi ekle</h1>
        <p class="page-lead">@provider.Description Gizli alanlar şifreli saklanır ve tekrar gösterilmez.</p>
    </div>
</div>

<form asp-action="Create" method="post" data-storage-form novalidate autocomplete="off">
    <partial name="_StorageForm" model="Model" />

    <div class="form-actions">
        <a asp-action="Index" class="btn-secondary" title="Kaydetmeden listeye dön">İptal</a>
        <button type="submit" class="btn-primary" title="Hedefi kaydet; ardından listeden test edebilirsiniz"><span class="spinner" data-spinner hidden></span> Kaydet</button>
    </div>
</form>
