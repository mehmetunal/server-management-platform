@model DockerPanelModel<IReadOnlyList<DockerNetworkDto>>
@{
    var networks = Model.Data;
    var canDelete = User.HasPermission(Permissions.DockerDelete);
}

<section class="panel">
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Network</th>
                    <th lang="en">Driver</th>
                    <th class="hidden md:table-cell">Subnet</th>
                    <th class="hidden lg:table-cell">Gateway</th>
                    <th>Bağlı <span lang="en">container</span>'lar</th>
                    @if (canDelete)
                    {
                        <th class="text-right">İşlemler</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (networks.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-slate-500">Network bulunamadı.</td></tr>
                }
                @foreach (var network in networks)
                {
                    <tr>
                        <td>
                            <span class="font-mono text-sm">@network.Name</span>
                            <div class="mt-0.5 flex flex-wrap items-center gap-1.5 text-xs text-slate-500">
                                <span class="font-mono">@network.ShortId</span>
                                @if (network.IsSystem)
                                {
                                    <span class="badge-neutral">sistem</span>
                                }
                                @if (network.Internal)
                                {
                                    <span class="badge-info">internal</span>
                                }
                            </div>
                        </td>
                        <td class="font-mono text-xs">@network.Driver <span class="text-slate-400">(@network.Scope)</span></td>
                        <td class="hidden font-mono text-xs md:table-cell">@(network.Subnets.Count == 0 ? "—" : string.Join(", ", network.Subnets))</td>
                        <td class="hidden font-mono text-xs lg:table-cell">@(network.Gateways.Count == 0 ? "—" : string.Join(", ", network.Gateways))</td>
                        <td>
                            @if (network.Containers.Count == 0)
                            {
                                <span class="text-sm text-slate-400">—</span>
                            }
                            else
                            {
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var container in network.Containers)
                                    {
                                        <a asp-action="Container" asp-route-id="@Model.ServerId" asp-route-name="@container.Name" class="tag font-mono" title="@container.IpAddress">@container.Name</a>
                                    }
                                </div>
                            }
                        </td>
                        @if (canDelete)
                        {
                            <td class="text-right">
                                @if (network.IsSystem || network.Containers.Count > 0)
                                {
                                    <span class="text-xs text-slate-400" title="@(network.IsSystem ? "Sistem network'ü silinemez" : "Bağlı container'ı olan network silinemez")">—</span>
                                }
                                else
                                {
                                    <button type="button" class="btn-ghost-danger btn-sm px-2" title="Network'ü sil"
                                            data-ajax-action data-url="@Url.Action("RemoveNetwork", new { id = Model.ServerId })"
                                            data-field-name="@network.Name"
                                            data-confirm-title="Network'ü sil"
                                            data-confirm-message="@network.Name network'ü silinecek."
                                            data-confirm-label="Network'ü sil">
                                        @Icons.Render("trash", "h-4 w-4")
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
