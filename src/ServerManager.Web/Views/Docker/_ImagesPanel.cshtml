@model DockerPanelModel<IReadOnlyList<DockerImageDto>>
@{
    var images = Model.Data;
    var canDelete = User.HasPermission(Permissions.DockerDelete);
    var totalSize = images.GroupBy(i => i.Id).Sum(g => g.First().SizeBytes);
}

@if (images.Count == 0)
{
    <section class="panel">
        <div class="empty-state">
            <span class="empty-state-icon">@Icons.Render("archive", "h-6 w-6")</span>
            <p class="font-medium text-slate-700 dark:text-slate-200">Bu sunucuda image yok</p>
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="panel-header">
            <h2 class="panel-title">@images.Count image</h2>
            <span class="text-xs text-slate-500">Toplam @MetricDisplay.Bytes(totalSize)</span>
        </div>
        <div class="overflow-x-auto">
            <table class="data-table">
                <thead>
                    <tr>
                        <th lang="en">Repository</th>
                        <th>Tag</th>
                        <th class="hidden md:table-cell">ID</th>
                        <th class="text-right">Boyut</th>
                        <th class="hidden lg:table-cell">Oluşturulma</th>
                        <th class="text-right" lang="en">Container</th>
                        @if (canDelete)
                        {
                            <th class="text-right">İşlemler</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var image in images)
                    {
                        <tr class="@(image.IsDangling ? "text-slate-400 dark:text-slate-500" : "")">
                            <td class="max-w-[20rem] break-all font-mono text-sm">
                                @(image.IsDangling ? "<none>" : image.Repository)
                                @if (image.IsDangling)
                                {
                                    <span class="badge-neutral ml-1">etiketsiz</span>
                                }
                            </td>
                            <td class="font-mono text-sm">@image.Tag</td>
                            <td class="hidden font-mono text-xs md:table-cell" title="@image.Id">@image.ShortId</td>
                            <td class="text-right tabular-nums">@MetricDisplay.Bytes(image.SizeBytes)</td>
                            <td class="hidden text-sm lg:table-cell">@DateDisplay.Format(image.CreatedAt, "dd.MM.yyyy HH:mm")</td>
                            <td class="text-right tabular-nums">@(image.ContainerCount?.ToString() ?? "—")</td>
                            @if (canDelete)
                            {
                                <td class="text-right">
                                    <button type="button" class="btn-ghost-danger btn-sm px-2" title="Image'ı sil"
                                            data-ajax-action data-url="@Url.Action("RemoveImage", new { id = Model.ServerId })"
                                            data-field-reference="@image.Reference"
                                            data-confirm-title="Image'ı sil"
                                            data-confirm-message="@image.Reference silinecek. Bu image'ı kullanan container varsa işlem reddedilir."
                                            data-confirm-check="Zorla sil (docker rmi -f)"
                                            data-confirm-label="Image'ı sil">
                                        @Icons.Render("trash", "h-4 w-4")
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
