@{
    ViewData["Title"] = "Hata";
    if (User.Identity?.IsAuthenticated != true)
    {
        Layout = "_AuthLayout";
    }
}
<div class="panel mx-auto max-w-lg">
    <div class="empty-state">
        <span class="empty-state-icon bg-red-100 text-red-500 dark:bg-red-950 dark:text-red-400">@Icons.Render("warning", "h-6 w-6")</span>
        <h1 class="text-lg font-semibold">Beklenmeyen bir hata oluştu</h1>
        <p>İşleminiz tamamlanamadı. Sorun devam ederse aşağıdaki referans numarasıyla destek ekibine başvurun.</p>
        <code class="mt-2 rounded-lg bg-slate-100 px-3 py-1 font-mono text-xs dark:bg-slate-800">@ViewData["TraceId"]</code>
        <a asp-controller="Dashboard" asp-action="Index" class="btn-secondary mt-4">Dashboard'a dön</a>
    </div>
</div>
