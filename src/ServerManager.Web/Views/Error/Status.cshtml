@{
    var statusCode = ViewData["StatusCode"] as int? ?? 500;
    var (title, message) = statusCode switch
    {
        404 => ("Sayfa bulunamadı", "Aradığınız sayfa veya kayıt mevcut değil ya da kaldırılmış olabilir."),
        403 => ("Erişim reddedildi", "Bu kaynağa erişim yetkiniz yok."),
        429 => ("Çok fazla istek", "Kısa sürede çok fazla istek gönderildi. Lütfen biraz bekleyin."),
        _ => ("Bir sorun oluştu", "İsteğiniz işlenemedi.")
    };
    ViewData["Title"] = title;
    if (User.Identity?.IsAuthenticated != true)
    {
        Layout = "_AuthLayout";
    }
}
<div class="panel mx-auto max-w-lg">
    <div class="empty-state">
        <span class="text-5xl font-bold text-slate-300 dark:text-slate-700">@statusCode</span>
        <h1 class="text-lg font-semibold">@title</h1>
        <p>@message</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn-secondary mt-4">Dashboard'a dön</a>
    </div>
</div>
