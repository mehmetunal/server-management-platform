@model CreateUserDto
@{
    ViewData["Title"] = "Kullanıcı ekle";
    ViewData["Page"] = "user-form";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="Kullanıcı listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Kullanıcılar</a>
        <h1 class="page-title">Kullanıcı ekle</h1>
        <p class="page-lead">Panele giriş yapacak yeni bir kullanıcı tanımlayıp rolünü seçin.</p>
    </div>
</div>

<form asp-action="Create" method="post" class="panel user-form" data-user-form novalidate autocomplete="off">
    <div class="panel-body user-form-grid">
        <p class="alert-error sm:col-span-2" data-form-error hidden></p>
        <div>
            <label asp-for="Email" class="form-label">E-posta *</label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="off" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="FullName" class="form-label">Ad soyad</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="field-validation-error"></span>
        </div>
        <div class="sm:col-span-2">
            <label for="Role" class="form-label">Rol *</label>
            <partial name="_RoleSelect" model="Model.Role" />
            <span asp-validation-for="Role" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="Password" class="form-label">Parola *</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
            <p class="form-hint">En az 10 karakter; büyük harf, küçük harf ve rakam içermeli.</p>
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword" class="form-label">Parola (tekrar) *</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
        </div>
    </div>
    <div class="form-actions">
        <a asp-action="Index" class="btn-secondary" title="Kaydetmeden listeye dön">İptal</a>
        <button type="submit" class="btn-primary" title="Kullanıcıyı oluştur"><span class="spinner" data-spinner hidden></span> Oluştur</button>
    </div>
</form>
