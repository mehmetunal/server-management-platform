@model SettingsPageViewModel
@{
    ViewData["Title"] = "Ayarlar";
    ViewData["Page"] = "settings-index";
    var info = Model.Info;
    var canManage = User.HasPermission(Permissions.SettingsManage);
    var uptime = DateTime.UtcNow - DateTime.SpecifyKind(info.StartedAtUtc, DateTimeKind.Utc);
    var agent = info.Sections.FirstOrDefault(s => s.Title == "Agent");
    var visibleSections = canManage ? info.Sections.Where(s => s.Title != "Agent") : info.Sections;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Ayarlar</h1>
        <p class="page-lead">@(canManage
            ? "İzleme, alarm, yedek, tarama ve bulut aralıklarını, kayıt saklama sürelerini buradan değiştirirsiniz. Bağlantı ve anahtarlar burada yoktur."
            : "Çalışan yapılandırma. Aralıkları değiştirmek için ayar yönetimi yetkisi gerekir.")</p>
    </div>
</div>

<div class="settings-summary">
    <div class="panel settings-tile">
        <p class="settings-tile-label">Sürüm</p>
        <p class="settings-tile-value">@info.Version</p>
        <p class="settings-tile-hint">.NET @info.Runtime</p>
    </div>
    <div class="panel settings-tile">
        <p class="settings-tile-label">Ortam</p>
        <p class="settings-tile-value">@info.EnvironmentName</p>
        <p class="settings-tile-hint">@info.OperatingSystem</p>
    </div>
    <div class="panel settings-tile">
        <p class="settings-tile-label">Çalışma süresi</p>
        <p class="settings-tile-value">@Uptime(uptime)</p>
        <p class="settings-tile-hint" title="@DateDisplay.Format(info.StartedAtUtc, "dd.MM.yyyy HH:mm:ss")">@DateDisplay.Relative(info.StartedAtUtc) başladı</p>
    </div>
    <div class="panel settings-tile">
        <p class="settings-tile-label">Veritabanı</p>
        <p class="settings-tile-value">@(info.Database.IsConnected ? "Bağlı" : "Yok")</p>
        <p class="settings-tile-hint">@(info.Database.SchemaVersion is { } version ? $"Şema {version}" : info.Database.Message)</p>
    </div>
</div>

@if (canManage)
{
    <form asp-action="Save" method="post" class="settings-form" data-settings-form novalidate>
        @Html.AntiForgeryToken()
        <p class="alert-error" data-form-error hidden></p>
        @foreach (var group in Model.Groups)
        {
            <section class="panel">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">@group.Title</h2>
                        <p class="settings-card-lead">@Lead(group.Title)</p>
                    </div>
                </div>
                @foreach (var cluster in group.Fields.GroupBy(field => field.Cluster ?? string.Empty))
                {
                    <div class="settings-cluster">
                        @if (!string.IsNullOrEmpty(cluster.Key))
                        {
                            <h3 class="settings-cluster-title">@cluster.Key</h3>
                        }
                        @if (cluster.Key == "Eşikler")
                        {
                            <div class="settings-thresholds">
                                @foreach (var pair in Thresholds(cluster))
                                {
                                    <div class="settings-threshold">
                                        <p class="settings-threshold-title">@pair.Title</p>
                                        <div class="settings-pair">
                                            <partial name="_SettingField" model="pair.Warning" />
                                            <partial name="_SettingField" model="pair.Critical" />
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="settings-grid">
                                @foreach (var field in cluster)
                                {
                                    <partial name="_SettingField" model="field" />
                                }
                            </div>
                        }
                    </div>
                }
            </section>
        }
        <div class="settings-actions">
            <div class="settings-actions-bar">
                <p class="settings-save-note">Kayıt, çalışan işlere bir sonraki turda yansır.</p>
                <button type="submit" class="btn-primary" title="Ayarları kaydet; çalışan işler bir sonraki turda yeni değeri kullanır">Kaydet</button>
            </div>
        </div>
    </form>
}
else
{
    <div class="settings-readonly">
        @foreach (var group in visibleSections)
        {
            <section class="panel">
                <div class="panel-header"><h2 class="panel-title">@group.Title</h2></div>
                <dl class="settings-list">
                    @foreach (var item in group.Items)
                    {
                        <div>
                            <dt>@item.Label</dt>
                            <dd>@item.Value</dd>
                        </div>
                    }
                </dl>
            </section>
        }
    </div>
}

@if (canManage && agent is not null)
{
    <section class="panel settings-agent">
        <div class="panel-header"><h2 class="panel-title">Agent</h2></div>
        <dl class="settings-list">
            @foreach (var item in agent.Items)
            {
                <div>
                    <dt>@item.Label</dt>
                    <dd>@item.Value</dd>
                </div>
            }
        </dl>
        <p class="settings-note">Agent aralığı kurulum betiğine gömülüdür. Token, sunucunun metrik sayfasından üretilir.</p>
    </section>
}

@functions {
    private static string Uptime(TimeSpan elapsed)
    {
        if (elapsed.TotalMinutes < 1) return $"{Math.Max(0, (int)elapsed.TotalSeconds)} sn";
        if (elapsed.TotalHours < 1) return $"{(int)elapsed.TotalMinutes} dk";
        if (elapsed.TotalDays < 1) return $"{(int)elapsed.TotalHours} sa {elapsed.Minutes} dk";
        return $"{(int)elapsed.TotalDays} gün {elapsed.Hours} sa";
    }

    private static string Lead(string title) => title switch
    {
        "İzleme" => "Ölçüm sıklığı, doluluk eşikleri ve saklama süreleri.",
        "Alarmlar" => "Kural değerlendirme, uptime ve SSL aralıkları.",
        "Yedekleme" => "Zamanlayıcı, saat dilimi ve zaman aşımı.",
        "Güvenlik taraması" => "Otomatik tarama ve eski kayıtların tutulması.",
        "Bulut" => "Sağlayıcı hesaplarının eşitlenme sıklığı.",
        "Kayıt saklama" => "Eski log ve geçmiş kayıtlarının tutulma süresi. 0 süresiz saklar; denetim kayıtları hiç silinmez.",
        _ => string.Empty
    };

    private static IEnumerable<(string Title, PanelSettingFieldDto Warning, PanelSettingFieldDto Critical)> Thresholds(
        IEnumerable<PanelSettingFieldDto> fields)
    {
        var list = fields.ToList();
        foreach (var (title, token) in new[] { ("CPU", "Cpu"), ("RAM", "Memory"), ("Disk", "Disk") })
        {
            var warning = list.First(field => field.Key.Contains(token, StringComparison.Ordinal) && field.Key.Contains("Warning", StringComparison.Ordinal));
            var critical = list.First(field => field.Key.Contains(token, StringComparison.Ordinal) && field.Key.Contains("Critical", StringComparison.Ordinal));
            yield return (title, warning, critical);
        }
    }
}
