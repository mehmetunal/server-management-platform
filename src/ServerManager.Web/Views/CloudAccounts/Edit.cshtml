@model CloudAccountFormViewModel
@{
    ViewData["Title"] = "Hesabı düzenle";
    ViewData["Page"] = "cloud-account-form";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="Hesap listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Bulut sağlayıcıları</a>
        <h1 class="page-title">Hesabı düzenle</h1>
        <p class="page-lead">Hesap adını değiştirin veya API anahtarını yenileyin.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Form.Id" method="post" data-cloud-account-form novalidate autocomplete="off">
    <partial name="_AccountForm" model="Model" />

    <div class="form-actions">
        <a asp-action="Index" class="btn-secondary" title="Kaydetmeden listeye dön">İptal</a>
        <button type="submit" class="btn-primary" title="Anahtarı doğrula ve kaydet"><span class="spinner" data-spinner hidden></span> Kaydet</button>
    </div>
</form>
