@model string

<section class="panel" data-panel-error>
    <div class="empty-state">
        <span class="empty-state-icon text-red-500">@Icons.Render("warning", "h-6 w-6")</span>
        <p class="font-medium text-slate-700 dark:text-slate-200">Sunucudan bilgi alınamadı</p>
        <p class="max-w-xl">@Model</p>
        <button type="button" class="btn-secondary btn-sm mt-3" data-panel-refresh title="Bilgiyi sunucudan yeniden oku">@Icons.Render("refresh", "h-4 w-4") Tekrar dene</button>
    </div>
</section>
