@model SslMonitorFormDto
@{
    ViewData["Title"] = "SSL izlemeyi düzenle";
    ViewData["Page"] = "ssl-form";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="SSL listesine dön">@Icons.Render("chevron-left", "h-4 w-4") SSL sertifikaları</a>
        <h1 class="page-title">@Model.Host</h1>
        <p class="page-lead">Alan adı veya port değişirse sertifika yeniden okunur.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-ssl-form novalidate autocomplete="off">
    <partial name="_SslForm" model="Model" />

    <div class="form-actions">
        <a asp-action="Index" class="btn-secondary" title="Kaydetmeden listeye dön">İptal</a>
        <button type="submit" class="btn-primary" title="Değişiklikleri kaydet"><span class="spinner" data-spinner hidden></span> Kaydet</button>
    </div>
</form>
