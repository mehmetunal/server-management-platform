@model ServerPageViewModel
@{
    var server = Model.Server;
    var monitoring = Model.Monitoring;
    var snapshot = monitoring.Snapshot;
    ViewData["Title"] = server.Name;
    ViewData["Page"] = "server-details";
}

<partial name="_ServerHeader" model="Model" />

<div class="server-details-grid" data-region="server-details">
    <div class="server-details-main">
        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">Sunucu bilgileri</h2></div>
            <dl class="panel-body detail-list">
                <div><dt class="detail-term">Hostname</dt><dd class="detail-value font-mono">@server.Hostname</dd></div>
                <div><dt class="detail-term">IP adresi</dt><dd class="detail-value font-mono">@server.IpAddress</dd></div>
                <div><dt class="detail-term">SSH port</dt><dd class="detail-value font-mono">@server.SshPort</dd></div>
                <div><dt class="detail-term">Kullanıcı</dt><dd class="detail-value font-mono">@server.Username @(server.UseSudo ? "(sudo)" : "")</dd></div>
                <div><dt class="detail-term">Provider</dt><dd class="detail-value">@(server.Provider ?? "—")</dd></div>
                <div><dt class="detail-term">Lokasyon</dt><dd class="detail-value">@(server.Location ?? "—")</dd></div>
                <div><dt class="detail-term">İşletim sistemi</dt><dd class="detail-value">@(server.OperatingSystem ?? "—")</dd></div>
                <div><dt class="detail-term">Ortam</dt><dd class="detail-value">@ServerDisplay.EnvironmentText(server.Environment)</dd></div>
                <div class="sm:col-span-2">
                    <dt class="detail-term">Etiketler</dt>
                    <dd class="detail-value flex flex-wrap gap-1">
                        @if (server.Tags.Count == 0)
                        {
                            <span class="text-slate-400">—</span>
                        }
                        @foreach (var tag in server.Tags)
                        {
                            <a asp-action="Index" asp-route-tag="@tag" class="tag" title="Bu etiketli sunucuları listele">@tag</a>
                        }
                    </dd>
                </div>
                @if (!string.IsNullOrEmpty(server.Description))
                {
                    <div class="sm:col-span-2"><dt class="detail-term">Açıklama</dt><dd class="detail-value whitespace-pre-line">@server.Description</dd></div>
                }
            </dl>
        </section>

        <section class="panel">
            <div class="panel-header">
                <h2 class="panel-title">Sistem</h2>
                <a asp-action="Metrics" asp-route-id="@server.Id" class="panel-link" title="Metrics sekmesini aç">Metrikler ve grafikler</a>
            </div>
            @if (snapshot is null)
            {
                <div class="empty-state">
                    <span class="empty-state-icon">@Icons.Render("chart", "h-6 w-6")</span>
                    <p class="empty-state-title">Henüz metrik toplanmadı</p>
                    <p>@(monitoring.HasTrustedHostKey ? "İlk ölçüm birkaç saniye içinde gelecek." : "Önce \"Bağlantıyı Test Et\" ile host key'i doğrulayın.")</p>
                </div>
            }
            else
            {
                <dl class="panel-body detail-list">
                    <div><dt class="detail-term">Hostname (sunucudan)</dt><dd class="detail-value font-mono">@(snapshot.System.Hostname ?? "—")</dd></div>
                    <div><dt class="detail-term">Kernel</dt><dd class="detail-value font-mono">@(snapshot.System.Kernel ?? "—") @(snapshot.System.Architecture is null ? "" : $"({snapshot.System.Architecture})")</dd></div>
                    <div><dt class="detail-term">CPU</dt><dd class="detail-value">@snapshot.CpuCores çekirdek · @snapshot.CpuThreads thread</dd></div>
                    <div><dt class="detail-term">Bellek</dt><dd class="detail-value">@MetricDisplay.Bytes(snapshot.MemoryUsedBytes) / @MetricDisplay.Bytes(snapshot.MemoryTotalBytes)</dd></div>
                    <div><dt class="detail-term">Zaman dilimi</dt><dd class="detail-value">@(snapshot.System.Timezone ?? "—")</dd></div>
                    <div><dt class="detail-term">Açılış zamanı</dt><dd class="detail-value">@DateDisplay.Format(snapshot.System.BootTimeUtc)</dd></div>
                </dl>
            }
        </section>
    </div>

    <div class="server-details-side">
        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">Bağlantı ve izleme</h2></div>
            <dl class="panel-body space-y-4">
                <div>
                    <dt class="detail-term">Son test</dt>
                    <dd class="detail-value">
                        @if (server.LastConnectionTestAt.HasValue)
                        {
                            <span class="@(server.LastConnectionSucceeded == true ? "badge-success" : "badge-danger")">@(server.LastConnectionSucceeded == true ? "Başarılı" : "Başarısız")</span>
                            <span class="ml-2 text-xs text-slate-500">@DateDisplay.Format(server.LastConnectionTestAt)</span>
                        }
                        else
                        {
                            <span class="text-slate-400">Henüz test edilmedi</span>
                        }
                    </dd>
                </div>
                @if (!string.IsNullOrEmpty(server.LastConnectionMessage))
                {
                    <div><dt class="detail-term">Sonuç</dt><dd class="detail-value text-slate-600 dark:text-slate-300">@server.LastConnectionMessage</dd></div>
                }
                <div>
                    <dt class="detail-term">Otomatik izleme</dt>
                    <dd class="detail-value">@(server.MonitoringEnabled ? "Açık" : "Kapalı")</dd>
                </div>
                <div>
                    <dt class="detail-term">Son görülme</dt>
                    <dd class="detail-value">@DateDisplay.Format(server.LastSeenAt) <span class="text-xs text-slate-500">@(server.LastSeenAt.HasValue ? $"({DateDisplay.Relative(server.LastSeenAt)})" : "")</span></dd>
                </div>
                <div>
                    <dt class="detail-term">Erişilebilirlik (24 saat)</dt>
                    <dd class="detail-value">@MetricDisplay.Percent(monitoring.UptimePercent24h)</dd>
                </div>
                <div>
                    <dt class="detail-term">Host key fingerprint</dt>
                    <dd class="detail-value break-all font-mono text-xs">@(server.HostKeyFingerprint ?? "İlk başarılı bağlantıda kaydedilecek")</dd>
                </div>
            </dl>
        </section>

        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">Kimlik bilgileri</h2></div>
            <dl class="panel-body space-y-4">
                <div><dt class="detail-term">Yöntem</dt><dd class="detail-value">@ServerDisplay.AuthenticationTypeText(server.AuthenticationType)</dd></div>
                @if (server.AuthenticationType == AuthenticationType.Password)
                {
                    <div><dt class="detail-term">SSH parolası</dt><dd class="detail-value font-mono">@(server.HasPassword ? "••••••••••" : "Tanımlı değil")</dd></div>
                }
                else
                {
                    <div><dt class="detail-term">Private key</dt><dd class="detail-value font-mono">@(server.HasPrivateKey ? "•••••••••• (şifreli)" : "Tanımlı değil")</dd></div>
                    @if (server.AuthenticationType == AuthenticationType.PrivateKeyWithPassphrase)
                    {
                        <div><dt class="detail-term">Passphrase</dt><dd class="detail-value font-mono">@(server.HasPassphrase ? "••••••••••" : "Tanımlı değil")</dd></div>
                    }
                }
                @if (server.UseSudo)
                {
                    <div><dt class="detail-term">Sudo parolası</dt><dd class="detail-value font-mono">@(server.HasSudoPassword ? "••••••••••" : "NOPASSWD / tanımlı değil")</dd></div>
                }
            </dl>
        </section>

        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">Kayıt bilgisi</h2></div>
            <dl class="panel-body space-y-4">
                <div><dt class="detail-term">Oluşturulma</dt><dd class="detail-value">@DateDisplay.Format(server.CreatedAt) · @(server.CreatedBy ?? "—")</dd></div>
                <div><dt class="detail-term">Son güncelleme</dt><dd class="detail-value">@DateDisplay.Format(server.UpdatedAt) @(server.UpdatedBy is null ? "" : $"· {server.UpdatedBy}")</dd></div>
            </dl>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
}
