@model CreateServerDto
@{
    ViewData["Title"] = "Sunucu ekle";
    ViewData["Page"] = "server-form";
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="back-link" title="Sunucu listesine dön">@Icons.Render("chevron-left", "h-4 w-4") Sunucular</a>
        <h1 class="page-title">Sunucu ekle</h1>
        <p class="page-lead">SSH bilgileriyle yeni bir sunucu tanımlayın.</p>
    </div>
</div>

<form asp-action="Create" method="post" data-server-form novalidate autocomplete="off">
    @if (Model.CloudAccountId is not null)
    {
        <input type="hidden" asp-for="CloudAccountId" />
        <input type="hidden" asp-for="CloudExternalId" />
        <p class="alert-info mb-6">Bu sunucu bulut hesabından içe aktarılıyor. Kaydedildiğinde hesaba bağlanır ve aylık maliyeti eşitleme sırasında otomatik güncellenir. SSH kimlik bilgilerini girmeniz yeterli.</p>
    }
    <partial name="_ServerForm" model="Model" />

    <div class="server-form-actions">
        <a asp-action="Index" class="btn-secondary" title="Kaydetmeden listeye dön">İptal</a>
        <button type="submit" class="btn-primary" title="Sunucuyu panele ekle"><span class="spinner" data-spinner hidden></span> Kaydet</button>
    </div>
</form>
