@model ServerPageViewModel
@{
    var server = Model.Server;
    ViewData["Title"] = $"{server.Name} · Metrikler";
    ViewData["Page"] = "server-metrics";
    var rangeCode = MetricRanges.Code(Model.Range);
    var latest = Model.Monitoring.Latest;
    string Invariant(long value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var charts = new[]
    {
        ("cpu", "CPU kullanımı"),
        ("memory", "RAM kullanımı"),
        ("disk", "Disk kullanımı (en dolu bölüm)"),
        ("network", "Ağ trafiği"),
        ("load", "Load average (1 dk)")
    };
    string Description(MetricRange range) =>
        $"{MetricRanges.DisplayName(range)} · {(MetricRanges.UsesHourlyData(range) ? "saatlik ortalamalar" : "ham ölçümler")}";
}

<partial name="_ServerHeader" model="Model" />

<div class="metrics-toolbar">
    <div class="range-switch" role="group" aria-label="Zaman aralığı">
        @foreach (var range in MetricRanges.All)
        {
            var code = MetricRanges.Code(range);
            <a asp-action="Metrics" asp-route-id="@server.Id" asp-route-range="@code"
               class="range-option @(range == Model.Range ? "is-active" : "")"
               title="@MetricRanges.DisplayName(range)"
               data-range-link
               data-series-url="@Url.Action("MetricSeries", new { id = server.Id, range = code })"
               data-live="@(range == MetricRange.OneHour ? "true" : "false")"
               data-description="@Description(range)" title="@Description(range)">@code</a>
        }
    </div>
    <p class="text-sm text-slate-500 dark:text-slate-400" data-range-description>@Description(Model.Range)</p>
</div>

<div class="metrics-grid" data-metric-charts data-series-url="@Url.Action("MetricSeries", new { id = server.Id, range = rangeCode })" data-live-range="@(Model.Range == MetricRange.OneHour ? "true" : "false")"
     data-cpu-threads="@(latest?.CpuThreads ?? 0)" data-memory-total="@Invariant(latest?.MemoryTotalBytes ?? 0)" data-disk-total="@Invariant(latest?.DiskTotalBytes ?? 0)">
    @foreach (var (key, title) in charts)
    {
        <section class="panel @(key == "load" ? "lg:col-span-2" : "")">
            <div class="panel-header">
                <h2 class="panel-title">@title</h2>
                <span class="text-xs tabular-nums text-slate-500 dark:text-slate-400" title="Son ölçüm">
                    @switch (key)
                    {
                        case "cpu":
                            <span data-resource="cpu"><span data-resource-detail>@MetricDisplay.CpuCores(latest?.CpuUsagePercent, latest?.CpuThreads)</span> · <span class="font-semibold text-slate-900 dark:text-slate-100" data-resource-text>@MetricDisplay.Percent(latest?.CpuUsagePercent)</span></span>
                            break;
                        case "memory":
                            <span data-resource="memory"><span data-resource-detail>@MetricDisplay.UsedOfTotal(latest?.MemoryUsedBytes ?? 0, latest?.MemoryTotalBytes ?? 0)</span> · <span class="font-semibold text-slate-900 dark:text-slate-100" data-resource-text>@MetricDisplay.Percent(latest?.MemoryUsagePercent)</span></span>
                            break;
                        case "disk":
                            <span data-resource="disk"><span data-resource-detail>@MetricDisplay.UsedOfTotal(latest?.DiskUsedBytes ?? 0, latest?.DiskTotalBytes ?? 0)</span> · <span class="font-semibold text-slate-900 dark:text-slate-100" data-resource-text>@MetricDisplay.Percent(latest?.DiskUsagePercent)</span></span>
                            break;
                        case "network":
                            <span>↓ <span class="font-semibold text-slate-900 dark:text-slate-100" data-live-rx>@MetricDisplay.Rate(latest?.NetworkRxBytesPerSecond)</span> · ↑ <span class="font-semibold text-slate-900 dark:text-slate-100" data-live-tx>@MetricDisplay.Rate(latest?.NetworkTxBytesPerSecond)</span></span>
                            break;
                        default:
                            <span class="font-semibold text-slate-900 dark:text-slate-100" data-live-load>@MetricDisplay.Number(latest?.LoadAverage1)</span>
                            break;
                    }
                </span>
            </div>
            <div class="panel-body">
                <div class="chart-box">
                    <canvas data-metric-chart="@key" aria-label="@title grafiği" role="img"></canvas>
                    <p class="chart-empty" data-chart-empty hidden>Bu aralık için veri yok.</p>
                </div>
            </div>
        </section>
    }
</div>

<div class="mt-6" data-metrics-panel data-panel-url="@Url.Action("MetricsPanel", new { id = server.Id })">
    <partial name="_MetricsPanel" model="new MetricsPanelViewModel { Monitoring = Model.Monitoring, Thresholds = Model.Thresholds }" />
</div>

<div class="mt-6" data-agent-panel data-panel-url="@Url.Action("Panel", "Agent", new { id = server.Id })" aria-live="polite">
    <section class="panel"><div class="panel-body text-sm text-slate-500">Agent durumu yükleniyor…</div></section>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
}
