@model ServerIndexViewModel
@{
    ViewData["Title"] = "Sunucular";
    ViewData["Page"] = "servers-index";
    var canCreate = User.HasPermission(Permissions.ServerCreate);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Sunucular</h1>
        <p class="page-lead">Panelden yönetilen Linux sunucuları; arayın, filtreleyin ve ayrıntılarına gidin</p>
    </div>
    @if (canCreate)
    {
        <a asp-action="Create" class="btn-primary" title="Panele yeni Linux sunucusu ekle">@Icons.Render("plus", "h-4 w-4") Sunucu ekle</a>
    }
</div>

<section class="panel">
    <form method="get" asp-action="Index" class="panel-toolbar server-filters" data-list-filter>
        <div class="search-field lg:col-span-2">
            <span class="search-field-icon">@Icons.Render("search", "h-4 w-4")</span>
            <input type="search" name="search" value="@Model.Filter.Search" class="form-control" placeholder="Ad, hostname, IP, provider ara…" data-live-search aria-label="Sunucu ara" />
        </div>
        <select name="status" class="form-control" data-auto-submit asp-items="ServerDisplay.StatusOptions(Model.Filter.Status)" aria-label="Durum">
            <option value="">Tüm durumlar</option>
        </select>
        <select name="environment" class="form-control" data-auto-submit asp-items="ServerDisplay.EnvironmentOptions(Model.Filter.Environment)" aria-label="Ortam">
            <option value="">Tüm ortamlar</option>
        </select>
        <select name="tag" class="form-control" data-auto-submit aria-label="Etiket">
            <option value="">Tüm etiketler</option>
            @foreach (var tag in Model.Tags)
            {
                <option value="@tag" selected="@(tag == Model.Filter.Tag)">@tag</option>
            }
        </select>
        <select name="groupId" class="form-control" data-auto-submit aria-label="Grup">
            <option value="">Tüm gruplar</option>
            @foreach (var group in Model.Groups)
            {
                <option value="@group.Id" selected="@(group.Id == Model.Filter.GroupId)">@group.Name</option>
            }
        </select>
        <div class="server-filter-actions">
            <button type="submit" class="btn-secondary btn-sm" title="Listeyi arama ve filtrelere göre süz">@Icons.Render("search", "h-4 w-4") Filtrele</button>
            <a asp-action="Index" class="btn-ghost btn-sm" data-list-link title="Tüm filtreleri kaldır">Filtreleri temizle</a>
        </div>
    </form>

    <div data-ajax-list>
        <partial name="_ServerList" model="Model" />
    </div>
</section>

<div data-live-fleet data-hub-url="@Url.Content("~" + MonitoringHub.Path)" hidden></div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
}
