@model UpdateServerDto
@{
    ViewData["Title"] = $"{Model.Name} · Düzenle";
    ViewData["Page"] = "server-form";
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="back-link" title="Sunucu sayfasına dön">@Icons.Render("chevron-left", "h-4 w-4") @Model.Name</a>
        <h1 class="page-title">Sunucuyu düzenle</h1>
        <p class="page-lead">Bağlantı adresi değişirse kayıtlı host key fingerprint sıfırlanır.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-server-form novalidate autocomplete="off">
    <partial name="_ServerForm" model="Model" />

    <div class="server-form-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary" title="Kaydetmeden sunucu sayfasına dön">İptal</a>
        <button type="submit" class="btn-primary" title="Sunucu bilgilerini güncelle"><span class="spinner" data-spinner hidden></span> Değişiklikleri kaydet</button>
    </div>
</form>
