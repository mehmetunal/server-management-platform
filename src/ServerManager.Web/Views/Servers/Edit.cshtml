@model UpdateServerDto
@{
    ViewData["Title"] = $"{Model.Name} · Düzenle";
}

<div class="page-header">
    <div>
        <a asp-action="Details" asp-route-id="@Model.Id" class="mb-2 inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">@Icons.Render("chevron-left", "h-4 w-4") @Model.Name</a>
        <h1 class="page-title">Sunucuyu düzenle</h1>
        <p class="page-lead">Bağlantı adresi değişirse kayıtlı host key fingerprint sıfırlanır.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-loading novalidate autocomplete="off">
    <partial name="_ServerForm" model="Model" />

    <div class="mt-6 flex justify-end gap-3">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary">İptal</a>
        <button type="submit" class="btn-primary"><span class="spinner" data-spinner hidden></span> Değişiklikleri kaydet</button>
    </div>
</form>
