# docker compose bu dosyanin kopyasi olan .env dosyasini okur. .env asla commit edilmez.
MSSQL_SA_PASSWORD=ChangeThis_Str0ngPassword!
MSSQL_PORT=14340
# Yalnızca yerel test sunucusu (docker compose --profile test)
SSH_TEST_PASSWORD=ChangeThis_TestPassword1
SSH_TEST_PORT=2223
# Uygulama konteyneri (docker compose --profile app). Degerler yer tutucudur; gercek anahtar uretin.
# Security:MasterKey — Base64 kodlu 32 bayt: openssl rand -base64 32
SM_MASTER_KEY=
SM_DB_NAME=ServerManager
APP_PORT=8080
# Ilk SuperAdmin (kullanici yoksa olusturulur; kurulumdan sonra bos birakabilirsiniz)
SM_ADMIN_EMAIL=admin@example.com
SM_ADMIN_PASSWORD=ChangeThis_Admin1
# TLS sonlandiran ters vekil (Traefik/Nginx) arkasindaysa true
SM_TRUST_FORWARDED_HEADERS=false
# Deployment alan adlari icin Let's Encrypt (ACME) hesap e-postasi
SM_ACME_EMAIL=
TZ=Europe/Istanbul
